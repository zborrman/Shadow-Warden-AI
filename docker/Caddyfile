# ─────────────────────────────────────────────────────────────────────────────
#  Shadow Warden AI — Caddy v2.8+ reverse proxy
#
#  Features:
#    • HTTP/3 (QUIC) enabled by default in Caddy 2.8+  — requires UDP 443
#    • Automatic Alt-Svc: h3=":443" header advertised to browsers
#    • TLS via bring-your-own certs in ./ssl/  (fullchain.pem + privkey.pem)
#    • HSTS + security headers on all HTTPS responses
#    • HTTP → HTTPS permanent redirect on port 80
#
#  Routing (by hostname):
#    api.shadow-warden-ai.com       → warden:8001  (API gateway)
#    app.shadow-warden-ai.com       → portal:3001   (Next.js tenant portal)
#    analytics.shadow-warden-ai.com → analytics:8002
#    shadow-warden-ai.com
#    www.shadow-warden-ai.com       → /srv/landing  (static landing page)
#
#  TLS cert files (mount ./ssl → /etc/caddy/ssl):
#    /etc/caddy/ssl/fullchain.pem   — certificate chain (Let's Encrypt standard)
#    /etc/caddy/ssl/privkey.pem     — private key
#
#  To use Caddy's automatic HTTPS (ACME) instead of bring-your-own certs,
#  remove the `tls` directives and set your email in the global block:
#    { email you@example.com }
# ─────────────────────────────────────────────────────────────────────────────

{
	# Global options
	# HTTP/3 is on by default — no extra config needed.
	# Caddy automatically adds Alt-Svc response headers when h3 is active.
	admin 0.0.0.0:2019
	servers {
		metrics

		# ── Trusted proxy chain ───────────────────────────────────────────────
		# Two paths reach this proxy: the Cloudflare edge straight to :443, and
		# the `cloudflared` tunnel container on the docker network. Only those
		# peers may assert a client IP; anyone hitting the origin directly gets
		# their socket address used instead, so forwarded headers cannot be
		# spoofed to poison ERS / shadow ban / rate-limit buckets.
		#
		# Cloudflare ranges: https://www.cloudflare.com/ips/ (re-check on change)
		trusted_proxies static \
			private_ranges \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

		# Resolve {client_ip} from CF-Connecting-IP (Cloudflare overwrites it at
		# the edge on every request) and fall back to X-Forwarded-For. Ignored
		# entirely when the peer is not in trusted_proxies above.
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────────────
http:// {
	redir https://{host}{uri} 301
}

# ── Client-IP forwarding snippet (reused by every reverse_proxy) ──────────────
# {client_ip} is the address resolved through the trusted_proxies chain above —
# the true visitor when the request came via Cloudflare, the raw socket address
# when someone hit the origin directly. All three headers are *overwritten* (not
# appended), so a forged CF-Connecting-IP / X-Real-IP / X-Forwarded-For from an
# untrusted client is replaced before it reaches an upstream that trusts them.
(client_ip_headers) {
	header_up CF-Connecting-IP  {client_ip}
	header_up X-Real-IP         {client_ip}
	header_up X-Forwarded-For   {client_ip}
	header_up X-Forwarded-Proto {scheme}
}

# ── Origin lockdown: enforced at the firewall, NOT here ───────────────────────
# "Only Cloudflare can reach the origin" is enforced by an iptables DOCKER-USER
# rule on the VPS (/usr/local/sbin/cf-origin-lock.sh + cf-origin-lock.service):
# it drops any non-Cloudflare source hitting the Docker-published 80/443 on eth0.
# See docs/cloudflare-waf.md.
#
# Do NOT try to enforce this with Caddy `client_auth` (Authenticated Origin
# Pulls). All vhosts share one multi-SAN cert, and Caddy v2.11.4 silently drops
# `client_authentication` when it consolidates the connection policies of two or
# more same-cert subjects (`caddy adapt` emits zero client_authentication, config
# still reports "valid"). It was tried (#216/#217) and produced a control that
# looked active but enforced nothing — removed here to avoid security theater.

# ── Security header snippet (reused across all HTTPS sites) ───────────────────
(security_headers) {
	header {
		# HSTS — 2 years, include subdomains, preload-eligible
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Prevent MIME sniffing
		X-Content-Type-Options    "nosniff"
		# Clickjacking protection
		X-Frame-Options           "SAMEORIGIN"
		# CORP: same-site allows dashboard + portal on *.shadow-warden-ai.com subdomains
		Cross-Origin-Resource-Policy "same-site"
		# Permissions Policy — disable browser APIs not in use
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()"
		# HTTP/3 advertisement — browsers upgrade on the next request
		Alt-Svc                   `h3=":443"; ma=2592000`
		# Hide server identity
		-Server
	}
}

# ── API Gateway ───────────────────────────────────────────────────────────────
api.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	# API-specific CSP: no scripts/frames needed; default-src 'none' covers all fallback directives (ZAP 10055)
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; form-action 'none'"

	# Health probe (used by Caddy's own healthcheck on port 80 via HTTP redirect)
	handle /health {
		reverse_proxy warden:8001 {
			import client_ip_headers
		}
	}

	# WebSocket connections (community live metrics, compliance push)
	handle /ws/* {
		reverse_proxy warden:8001 {
			import client_ip_headers
			header_up Connection        {>Connection}
			header_up Upgrade           {>Upgrade}
		}
	}

	# All API traffic → Warden FastAPI gateway
	handle {
		reverse_proxy warden:8001 {
			import client_ip_headers
		}
	}
}

# ── Tenant Portal (Next.js) ───────────────────────────────────────────────────
app.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	handle {
		reverse_proxy portal:3001 {
			import client_ip_headers
		}
	}
}

# ── Analytics Dashboard ───────────────────────────────────────────────────────
analytics.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	handle {
		reverse_proxy analytics:8002 {
			import client_ip_headers
		}
	}
}

# ── Portal / SOC Dashboard (Next.js) — public-facing login + SOC UI ─────────
portal.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	# Next.js immutable static chunks — overwrite any upstream cache header
	@nextStatic path /_next/static/*
	header @nextStatic >Cache-Control "public, max-age=31536000, immutable"

	# HTML pages and API routes — force no-store so Cloudflare never caches page refs
	@noCache {
		not path /_next/static/*
		not path /_next/image*
	}
	header @noCache >Cache-Control "no-store, no-cache, must-revalidate"

	handle {
		reverse_proxy dashboard:3002 {
			import client_ip_headers
		}
	}
}

# ── SOC Dashboard (Next.js) ──────────────────────────────────────────────────
dash.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	handle {
		reverse_proxy dashboard:3002 {
			import client_ip_headers
		}
	}
}

# ── Grafana (OB-7) — NOT ENABLED YET, three prerequisites below ──────────────
#
# Grafana is bound to 127.0.0.1:3001 in docker-compose.yml, so today it is
# reachable only over an SSH tunnel:
#
#     ssh -L 3001:127.0.0.1:3001 root@<host>
#
# That is correct for one operator and wrong for a team. This vhost is the
# shared-access path, left commented because enabling it before the three
# prerequisites are met breaks Caddy at startup rather than degrading:
#
#   1. DNS — an A/AAAA record for grafana.shadow-warden-ai.com, proxied
#      (orange cloud) through Cloudflare.
#   2. TLS — this Caddyfile uses BRING-YOUR-OWN certs, not ACME. The mounted
#      /etc/caddy/ssl/cert.pem must already cover this hostname (a wildcard, or
#      the SAN reissued). Caddy fails to load a site whose cert file does not
#      match; it will not silently fall back.
#   3. Cloudflare Access — a self-hosted Access application in front of the
#      hostname, with a policy scoped to the operator group. Without it this is
#      a login page for every datasource credential in the stack, published on
#      the internet, protected only by one shared admin password.
#
# Then also set, in the host .env:
#     GRAFANA_ROOT_URL=https://grafana.shadow-warden-ai.com/
# and only once that is live, GF_SECURITY_COOKIE_SECURE=true in the compose
# service — setting it earlier breaks login over the plain-HTTP tunnel.
#
# grafana.shadow-warden-ai.com {
# 	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem
#
# 	import security_headers
#
# 	handle {
# 		reverse_proxy grafana:3000 {
# 			import client_ip_headers
# 		}
# 	}
# }

# ── API Documentation (Redoc) ────────────────────────────────────────────────
docs.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	root * /srv/docs
	try_files {path} {path}/index.html /index.html
	file_server
}

# ── Agentic Marketplace (Cloudflare Worker edge proxy) ───────────────────────
# Proxies to the shadow-warden-marketplace CF Worker; keeps TLS termination and
# HSTS headers on-domain while letting the Worker serve from Cloudflare's edge.
marketplace.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	# ADP standard path — cache 1 hour (matches Worker Cache-Control)
	@adp path /.well-known/agent.json
	header @adp Cache-Control "public, max-age=3600"

	handle {
		reverse_proxy https://shadow-warden-marketplace.zbrvladimir.workers.dev {
			header_up Host                shadow-warden-marketplace.zbrvladimir.workers.dev
			import client_ip_headers
			header_up X-Forwarded-Host    {host}
		}
	}
}

# ── Landing Page (static) ─────────────────────────────────────────────────────
shadow-warden-ai.com, www.shadow-warden-ai.com {
	tls /etc/caddy/ssl/cert.pem /etc/caddy/ssl/key.pem

	import security_headers

	# Landing page: Astro static HTML with inline scripts — REPLACE snippet CSP (> prefix overwrites)
	# without this the browser receives two CSP headers and enforces the most restrictive of both
	header >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'"

	# Cache static assets aggressively
	@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
	header @static Cache-Control "public, max-age=31536000, immutable"

	# robots.txt — short public cache, add CORP explicitly
	@robots path /robots.txt
	header @robots Cache-Control "public, max-age=86400"
	header @robots Cross-Origin-Resource-Policy "same-origin"

	# Same-origin auth proxy — avoids Cloudflare Bot Fight Mode on cross-origin XHR to api.*
	# The sw_session cookie (domain=.shadow-warden-ai.com) is sent with same-origin requests too.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy warden:8001 {
			import client_ip_headers
		}
	}

	# Agent Card — warden owns it; serving it here too means the URL that
	# llms.txt and .well-known/did.json advertise actually answers on this host.
	handle /.well-known/agent.json {
		reverse_proxy warden:8001 {
			import client_ip_headers
		}
	}

	handle {
		root * /srv/landing

		# ── Markdown content negotiation (https://acceptmarkdown.com) ─────────
		# Same URL as the HTML, decided by Accept. Caddy matchers cannot do the
		# full q-value arithmetic, so this is the conservative subset: markdown
		# only when it is named and not down-weighted. The exact rules (q-values,
		# 406, specificity) run at the Vercel edge for www — see
		# edge/negotiate.mjs, which is the reference implementation.
		@md_home {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /
		}
		rewrite @md_home /index.md
		@md_pricing {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /pricing /pricing/ /price /price/
		}
		rewrite @md_pricing /pricing.md
		@md_doc {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /doc /doc/
		}
		rewrite @md_doc /doc.md
		@md_sdk {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /sdk /sdk/
		}
		rewrite @md_sdk /sdk.md
		@md_agentic {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /agentic /agentic/
		}
		rewrite @md_agentic /agentic.md
		@md_trust {
			method GET HEAD
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
			path /trust /trust/
		}
		rewrite @md_trust /trust.md

		# Both variants must advertise that they vary, or a cache in front of us
		# hands one client's representation to the other.
		@page not path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
		header @page Vary "Accept, Accept-Encoding"

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		# Negotiated bodies must not be cached by an intermediary that ignores
		# Vary (Cloudflare only varies on Accept-Encoding).
		header @markdown Cache-Control "private, max-age=0, must-revalidate"

		# Astro static output: file → directory index → .html.
		# There is deliberately no /index.html fallback: serving the homepage
		# with 200 for every unknown path tells an agent that every path exists.
		try_files {path} {path}/index.html {path}.html

		file_server
	}

	# A missing path must say so. Without this, `try_files` used to fall back to
	# /index.html and every unknown URL answered 200 with the homepage — which
	# tells a crawler that every path it invents exists.
	handle_errors {
		root * /srv/landing

		# A markdown client that lands on a missing path gets the markdown
		# recovery body, not an HTML shell it cannot read. Same negotiation
		# subset as the pages above.
		@md_notfound {
			expression {err.status_code} == 404
			header Accept *text/markdown*
			not header Accept *text/markdown;q=0*
			not header Accept "*text/markdown; q=0*"
		}
		handle @md_notfound {
			rewrite * /404.md
			header Content-Type "text/markdown; charset=utf-8"
			header Vary "Accept, Accept-Encoding"
			file_server {
				status 404
			}
		}

		handle {
			rewrite * /{err.status_code}.html
			file_server {
				status {err.status_code}
			}
		}
	}
}
