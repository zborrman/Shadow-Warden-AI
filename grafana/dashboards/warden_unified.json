          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (strategy) (rate(warden_shadow_ban_total[$__rate_interval]))",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 30,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "title": "Fail-open Bypass Rate",
      "description": "warden_filter_bypasses_total over /filter throughput. Non-zero means requests are reaching the model unfiltered.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(warden_filter_bypasses_total[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"warden\",handler=\"/filter\"}[$__rate_interval])), 0.001) * 100",
          "legendFormat": "bypass %"
        }
      ]
    },
