    {
      "type": "timeseries",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "title": "/filter Request Rate by Status",
      "description": "prometheus-fastapi-instrumentator groups status codes, so the series are 2xx / 4xx / 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"warden\",handler=\"/filter\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "title": "Rejected Requests (4xx)",
      "description": "Proxy for the block rate: the gateway answers a blocked payload with a 4xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "fixedColor": "#FF2D55",
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"warden\",status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "title": "/filter Latency — P99 / P50",
      "description": "P99/P50 on POST /filter. Buckets are SLO-bracketed as of OB-5 (5 edges below 100 ms), so these quantiles can actually resolve the P99 < 50 ms commitment in docs/sla.md — before OB-5 the first bucket was 0.1 s and every value here was an interpolation inside it. Note the series restarted at that change: history across it is not comparable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"warden\",handler=\"/filter\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"warden\",handler=\"/filter\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "type": "timeseries",
