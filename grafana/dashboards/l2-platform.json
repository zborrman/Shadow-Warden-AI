{
  "annotations": {
    "list": []
  },
  "description": "L2 diagnostic board: the plumbing under the product, plus the observability stack watching itself. Opened deliberately, never alerted on — the alerting for these paths lives on the L0 and L1 boards.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 49,
      "title": "Scrape Health — the stack observing itself",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 50,
      "title": "Scrape Duration by Job",
      "description": "scrape_duration_seconds — Prometheus's own synthetic series, present for every target. A job creeping toward the 15s scrape_interval will start missing samples, which shows up downstream as gappy panels rather than as an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 51,
      "title": "Targets Up by Job",
      "description": "Same data as the L0 status tiles, kept here as a time series so a flapping target is visible rather than averaged away.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 52,
      "title": "Event Bus & Tunnels",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 53,
      "title": "Stream Events by Topic",
      "description": "warden_streams_events_total{topic,direction} — Kafka/Flink event bus. A topic with produce but no consume is a backing-up consumer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, direction) (rate(warden_streams_events_total[$__rate_interval]))",
          "legendFormat": "{{topic}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 54,
      "title": "MASQUE Tunnel Preflight by Region",
      "description": "warden_tunnel_preflight_total{region,status}. Tunnel lifecycle is PENDING → ACTIVE → DEGRADED (2 failures) → OFFLINE (5), so sustained failures here precede a sovereignty routing failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (region, status) (rate(warden_tunnel_preflight_total[$__rate_interval]))",
          "legendFormat": "{{region}} {{status}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 55,
      "title": "Notifications & Corpus Sync",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 56,
      "title": "Push Notifications by Risk Level",
      "description": "warden_push_notifications_sent_total{risk_level} — FCM deliveries to mobile SOC devices.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (risk_level) (rate(warden_push_notifications_sent_total[$__rate_interval]))",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 57,
      "title": "Corpus Snapshots Uploaded — 24h",
      "description": "warden_sync_corpus_uploads_total. Its download counterpart is on the Overview board; a node uploading but never downloading is isolated from the global threat-intel mesh.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(warden_sync_corpus_uploads_total[24h]))",
          "legendFormat": "uploads",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "id": 157,
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "logs",
      "id": 158,
      "title": "Background worker log",
      "description": "arq-worker runs the nightly backup, overage settlement, ledger and hold reconciliation, x402 settlement and the AML sweep. Pair with the job outcome metrics on the Service Health board: the counter says a job failed, this says why.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"arq-worker\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "id": 159,
      "title": "Gateway log — all levels",
      "description": "Unfiltered gateway stream, for when the level filter on the L0 board is hiding the context around an error.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
