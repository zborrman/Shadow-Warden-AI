        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, enforced) (rate(warden_marketplace_offer_signature_total[$__rate_interval]))",
          "legendFormat": "{{result}} / enforced={{enforced}}"
        }
      ]
    },
