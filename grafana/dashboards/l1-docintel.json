    {
      "type": "timeseries",
      "id": 48,
      "title": "Cache Hit Ratio",
      "description": "hits / (hits + conversions). A collapsing ratio means either the TTLs are wrong for the traffic or Redis is unavailable — the cache is fail-open, so it degrades to full conversions silently.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(warden_doc_intel_cache_hits_total[$__rate_interval])) / clamp_min(sum(rate(warden_doc_intel_cache_hits_total[$__rate_interval])) + sum(rate(warden_doc_intel_convert_total[$__rate_interval])), 0.001)",
          "legendFormat": "hit ratio"
        }
      ]
    }
