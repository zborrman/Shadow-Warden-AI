  "description": "LLM cost of goods sold. Producers: warden/finops/llm_budget.py and warden/staff/economics.py. Every one of these metrics was instrumented by FM-7 and graphed nowhere until OB-8 — the largest variable cost in the product was being written to a store no query read.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Spend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "LLM Spend — last 24h",
      "description": "sum(increase(warden_llm_cost_usd_total[24h])). Compare against the tier allowance derived in finops/llm_budget.py.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(warden_llm_cost_usd_total[24h]))",
          "legendFormat": "24h",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "LLM Spend — cumulative",
      "description": "Counter total since process start. Resets on restart; use the 24h figure for anything billing-facing.",
