# Shadow Warden AI — Community Business (SMB) Edition
# Copy this file to .env.smb and fill in your values.
# Minimum required: set WARDEN_API_KEY to a secure random string.
#
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Required ──────────────────────────────────────────────────────────────────
WARDEN_API_KEY=change-me-generate-with-secrets-token-urlsafe-32

# ── Optional: AI Evolution Engine (requires Anthropic account) ────────────────
# Leave blank to run in air-gapped mode (all detection still works).
ANTHROPIC_API_KEY=

# ── Optional: Slack alerts on HIGH/BLOCK detections ──────────────────────────
SLACK_WEBHOOK_URL=

# ── Optional: SMTP for compliance report emails ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMB Tier ──────────────────────────────────────────────────────────────────
WARDEN_TIER=community_business
TENANT_ID=my-business

# ── Security (auto-generated on first run if left blank) ──────────────────────
VAULT_MASTER_KEY=
COMMUNITY_VAULT_KEY=

# ── File Scanner ──────────────────────────────────────────────────────────────
FILE_SCAN_ENABLED=true
FILE_SCAN_MAX_MB=10

# ── Shadow AI Monitoring (MONITOR mode — alerts only, no blocking) ────────────
SHADOW_AI_MONITOR=true

# ── Data retention ────────────────────────────────────────────────────────────
RETENTION_DAYS=180

# ── Analytics dashboard auth (REQUIRED) ───────────────────────────────────────
# The Streamlit dashboard on :8501 reads the live /filter event stream — it
# shows your real security telemetry. Leave this blank and warden/analytics/auth.py
# runs in dev mode: no password, anyone who reaches the port is in.
#
# OB-F22 makes that fail closed, so the dashboard now refuses to start without
# a hash rather than starting open. Generate one:
#
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
#
# The port is bound to 127.0.0.1 in docker-compose.smb.yml; reach it over a
# tunnel:  ssh -L 8501:127.0.0.1:8501 <operator>@<host>
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
