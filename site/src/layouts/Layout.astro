---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Markdown representation of this page — see BaseLayout for the contract. */
  markdown?: string;
}

const {
  title = 'Shadow Warden AI — Zero-Trust AI Security Gateway',
  description = 'Zero-trust AI security gateway. A nine-stage filter blocks jailbreaks, decodes obfuscated payloads and strips secrets and PII before a prompt reaches a model. Content is never logged.',
  markdown,
} = Astro.props;

const SITE_URL = 'https://shadow-warden-ai.com';
// vercel.json serves this site with `cleanUrls` and `trailingSlash: false`,
// so /pricing/ redirects to /pricing. Canonical must name the 200, not the 308.
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(canonicalPath, Astro.site ?? SITE_URL).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Shadow Warden AI',
      url: SITE_URL,
      logo: `${SITE_URL}/logo.png`,
      sameAs: ['https://github.com/zborrman/Shadow-Warden-AI'],
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#03050F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="agent-protocol" href="/.well-known/agent.json" type="application/json" />
    <link rel="llms-txt" href="/llms.txt" type="text/plain" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Site index for machines" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version of this page" />}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body class="font-[Inter,system-ui,sans-serif] antialiased overflow-x-hidden">
    <!-- Noise texture overlay -->
    <div
      class="pointer-events-none fixed inset-0 z-0 opacity-[0.03]"
      style="background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\")"
    ></div>

    <slot />
  </body>
</html>
