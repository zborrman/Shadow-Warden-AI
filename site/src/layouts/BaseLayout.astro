---
import { PRODUCT } from '../data/product';
import '../styles/global.css';
import '../styles/shell.css';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Markdown representation of this page, e.g. '/pricing.md'. Published as a
   * `rel="alternate"` link so an agent can find it without guessing, and
   * negotiated on this same URL by edge/negotiate.mjs. Must agree with
   * MARKDOWN_ROUTES there — warden/tests/test_site_agent_readiness.py checks it.
   */
  markdown?: string;
  /** Extra JSON-LD node(s) for this page, merged into the site-wide @graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Show the Home › Hub › Page trail at the top of <main>. Off only for app
   * screens that already draw their own in-app trail (/account/*).
   */
  breadcrumbs?: boolean;
}

const {
  title = 'Shadow Warden AI — Zero-Trust AI Security Gateway',
  description = 'Zero-trust AI security gateway. A nine-stage filter blocks jailbreaks, decodes obfuscated payloads and strips secrets and PII before a prompt reaches a model. Content is never logged.',
  ogImage = '/logo.png',
  markdown,
  jsonLd,
  breadcrumbs = true,
} = Astro.props;

const SITE_URL = 'https://shadow-warden-ai.com';
// vercel.json serves this site with `cleanUrls` and `trailingSlash: false`,
// so /pricing/ redirects to /pricing. Canonical must name the 200, not the 308.
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(canonicalPath, Astro.site ?? SITE_URL).href;

// Structured identity, so an agent does not have to infer who this is from
// marketing copy. Organization + WebSite ship on every page; a page may add its
// own node (the homepage adds SoftwareApplication) via the `jsonLd` prop.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Shadow Warden AI',
      url: SITE_URL,
      logo: `${SITE_URL}/logo.png`,
      description: 'A workspace for Amazon sellers to catch listing, labelling and account-health risks early. Independent of Amazon.',
      sameAs: ['https://github.com/zborrman/Shadow-Warden-AI'],
      // An agent asked to verify who this is, or to reach a human, should not
      // have to scrape the contact page. contactType + email is what
      // schema.org's ContactPoint is for; `address` is what tells a verifier
      // which jurisdiction the counterparty sits in.
      //
      // Only the country is asserted. A street address, locality and postal
      // code are not published anywhere this repo can verify them, and an
      // invented address in machine-readable identity data is worse than an
      // incomplete one — it is the kind of claim a buyer's compliance review
      // checks. Fill the rest in from the registered entity when there is one.
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'technical support',
          email: 'vz@shadow-warden-ai.com',
          url: `${SITE_URL}/contact`,
          availableLanguage: ['en'],
        },
        {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: 'vz@shadow-warden-ai.com',
          url: `${SITE_URL}/contact`,
          availableLanguage: ['en'],
        },
        {
          '@type': 'ContactPoint',
          contactType: 'security',
          email: 'security@shadow-warden-ai.com',
          url: `${SITE_URL}/trust`,
          availableLanguage: ['en'],
        },
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'IL',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Shadow Warden AI',
      url: SITE_URL,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      ...(markdown ? { encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: new URL(markdown, SITE_URL).href } } : {}),
    },
    ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ],
};

// Five hubs, one per buyer job (docs: site concept plan, S1). Each item is a
// page that already exists; the hub only groups them. The roadmap-derived
// sub-pages keep their URLs — only where they are listed changed.
const LIVE_DASHBOARDS = [
  // Read-only Grafana public dashboards, served from metrics.<domain> where
  // Caddy passes only the public-dashboard paths (docker/Caddyfile). Chosen
  // because their panels return data; pre-launch, several read zero — which
  // is the truth, not a fault. The access tokens are public by design.
  { label: '● Live — Service Health',        href: 'https://metrics.shadow-warden-ai.com/public-dashboards/53657fb3227a4bb78d7ce2532899168a' },
  { label: '● Live — Marketplace Liquidity', href: 'https://metrics.shadow-warden-ai.com/public-dashboards/8212954652f74ca7a31f86a67bdad2e5' },
  { label: '● Live — Community Hub',         href: 'https://metrics.shadow-warden-ai.com/public-dashboards/5c3b6c9ec3c140f8b0eb44987d368789' },
];

type NavItem = { label: string; href: string } | { divider: true };

const categories: { label: string; href: string; color: string; items: NavItem[] }[] = [
  {
    label: 'Protect',
    href: '/cyber-security',
    color: '#f87171',
    items: [
      { label: 'Security Pipeline',       href: '/cyber-security/security-pipeline' },
      { label: 'Agentic SOC',             href: '/cyber-security/agentic-soc' },
      { label: 'Cryptography',            href: '/cyber-security/cryptography' },
      { label: 'AI Research & Evolution', href: '/cyber-security/ai-research-evolution' },
      { label: 'Document Intelligence',   href: '/cyber-security/document-intelligence' },
      { divider: true },
      { label: 'Playground',              href: '/playground' },
      { label: 'Fraud Score',             href: '/fraud-score' },
    ],
  },
  {
    label: 'Govern',
    href: '/trust',
    color: '#34d399',
    items: [
      { label: 'Trust Center',         href: '/trust' },
      { label: 'Compliance & Privacy', href: '/cyber-security/compliance-privacy' },
      { label: 'SMB Governance',       href: '/smb' },
      { label: 'Dashboards',           href: '/dashboard' },
      { label: 'Status',               href: '/status' },
      { divider: true },
      ...LIVE_DASHBOARDS,
    ],
  },
  {
    label: 'Trade',
    href: '/business-community',
    color: '#4d9cfc',
    items: [
      { label: 'Business Community',  href: '/business-community' },
      { label: 'M2M Commerce Store',  href: '/business-community/m2m-store' },
      { divider: true },
      { label: 'Sovereign Tunnel',    href: '/tunnel' },
      { label: 'MASQUE Tunnels',      href: '/tunnel/masque-tunnels' },
    ],
  },
  {
    label: 'Build',
    href: '/doc',
    color: '#fbbf24',
    items: [
      { label: 'Quick Start',    href: '/doc/quick-start' },
      { label: 'API Reference',  href: '/doc/api-reference' },
      { label: 'Authentication', href: '/doc/authentication' },
      { label: 'Rate Limits',    href: '/doc/rate-limits' },
      { divider: true },
      { label: 'SDK',            href: '/sdk' },
      { label: 'CLI',            href: '/cli' },
      { label: 'MCP',            href: '/mcp' },
      { label: 'Changelog',      href: '/doc/changelog' },
      { label: 'Roadmap',        href: '/roadmap' },
    ],
  },
  {
    label: 'Account',
    href: '/price',
    color: '#fb923c',
    items: [
      { label: 'Pricing',    href: '/price' },
      { label: 'Settings',   href: '/settings' },
      { label: 'Contact',    href: '/contact' },
    ],
  },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
// Quick links above the hubs. /sellers is the product (S0); the badge says
// the page is new, not that anything about it is measured.
const quickLinks: { label: string; href: string; badge?: string }[] = [
  { label: 'For Amazon sellers', href: '/sellers', badge: 'New' },
  { label: 'Docs',               href: '/doc' },
  { label: 'Pricing',            href: '/price' },
];

// One 24×24 stroke icon per destination (Lucide geometry, inlined so the
// sidebar costs no request). Unknown hrefs fall back to a dot.
const ICONS: Record<string, string> = {
  '/sellers': '<path d="M3 9h18l-1.5 10.5a2 2 0 0 1-2 1.5h-11a2 2 0 0 1-2-1.5L3 9Z"/><path d="M8 9V7a4 4 0 0 1 8 0v2"/>',
  '/doc': '<path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6.5A2.5 2.5 0 0 0 4 21.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/>',
  '/price': '<path d="M12.6 2.6 21.4 11.4a2 2 0 0 1 0 2.8l-7.2 7.2a2 2 0 0 1-2.8 0L2.6 12.6A2 2 0 0 1 2 11.2V4a2 2 0 0 1 2-2h7.2a2 2 0 0 1 1.4.6Z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  '/cyber-security/security-pipeline': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
  '/cyber-security/agentic-soc': '<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 4v4M9 13v2M15 13v2"/>',
  '/cyber-security/cryptography': '<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/>',
  '/cyber-security/ai-research-evolution': '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"/><path d="M7 15h10"/>',
  '/cyber-security/document-intelligence': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  '/playground': '<polygon points="6 3 20 12 6 21 6 3"/>',
  '/fraud-score': '<path d="M12 14 16 10"/><path d="M3.3 19a10 10 0 1 1 17.4 0"/>',
  '/trust': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  '/cyber-security/compliance-privacy': '<path d="M12 3v18M7 21h10M3 7h18M6 7l-3 8a3.5 3.5 0 0 0 6 0Zm12 0-3 8a3.5 3.5 0 0 0 6 0Z"/>',
  '/smb': '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01"/>',
  '/dashboard': '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  '/status': '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  '/business-community': '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  '/business-community/m2m-store': '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/>',
  '/tunnel': '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/>',
  '/tunnel/masque-tunnels': '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  '/doc/quick-start': '<path d="M5 19c-1.5 1.3-2 3-2 3s1.7-.5 3-2c.7-.8.7-2-.1-2.9A2.2 2.2 0 0 0 5 19ZM12 15l-3-3a22 22 0 0 1 2-4A13 13 0 0 1 22 2c0 2.7-.8 7.5-6 11a22 22 0 0 1-4 2Z"/>',
  '/doc/api-reference': '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  '/doc/authentication': '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>',
  '/doc/rate-limits': '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M10 2h4"/>',
  '/sdk': '<path d="M21 8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7Z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/>',
  '/cli': '<path d="m4 17 6-6-6-6M12 19h8"/>',
  '/mcp': '<path d="M12 22v-5M9 8V2M15 8V2M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/>',
  '/doc/changelog': '<path d="M3 12a9 9 0 1 0 9-9 9.8 9.8 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5M12 7v5l4 2"/>',
  '/roadmap': '<path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15M15 6v15"/>',
  '/settings': '<path d="M20 7h-9M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
  '/contact': '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
};
const icon = (href: string) => ICONS[href] ?? '<circle cx="12" cy="12" r="2.5"/>';
// The single most specific menu entry the current page sits under, so one
// row is marked current even when /tunnel and /tunnel/masque-tunnels both match.
const activeItem = categories
  .flatMap(c => c.items)
  .filter((i): i is { label: string; href: string } => 'href' in i && i.href.startsWith('/') && isActive(i.href))
  .sort((a, b) => b.href.length - a.href.length)[0];
// A hub is active when the current page is the hub or any page it lists.
// A page a hub lists by name belongs to that hub, even when it also sits under
// another hub's path (/cyber-security/compliance-privacy is listed by Govern
// but lives under Protect's /cyber-security), so exactly one hub lights up.
const listsCurrent = (cat: (typeof categories)[number]) =>
  cat.items.some(i => 'href' in i && i.href.startsWith('/') && isActive(i.href));
const ownerHub = categories.find(listsCurrent);
function isHubActive(cat: (typeof categories)[number]) {
  if (ownerHub) return cat === ownerHub;
  return isActive(cat.href);
}

// Breadcrumbs come from the same table as the nav, so a page can never sit
// under one hub in the menu and another in its trail. The hub is the one the
// menu lights up; the middle step is the longest menu entry the page sits
// under (e.g. /tunnel for /tunnel/per-tenant-routing), and only when it is
// neither the page itself nor the hub's own landing.
type Crumb = { label: string; href?: string };
const crumbHub = categories.find(isHubActive);
const pageLabel = title.replace(/\s+[—|–-]\s+.*$/, '').trim() || title;
const crumbs: Crumb[] = [];
if (breadcrumbs && currentPath !== '/') {
  const trimmed = currentPath.replace(/(.)\/$/, '$1');
  crumbs.push({ label: 'Home', href: '/' });
  if (crumbHub) {
    const onHub = trimmed === crumbHub.href;
    crumbs.push(onHub ? { label: crumbHub.label } : { label: crumbHub.label, href: crumbHub.href });
    if (!onHub) {
      const parent = crumbHub.items
        .filter((i): i is { label: string; href: string } =>
          'href' in i && i.href.startsWith('/') && i.href !== crumbHub.href && isActive(i.href))
        .sort((a, b) => b.href.length - a.href.length)[0];
      if (parent && parent.href !== trimmed) crumbs.push({ label: parent.label, href: parent.href });
      crumbs.push({ label: parent && parent.href === trimmed ? parent.label : pageLabel });
    }
  } else {
    crumbs.push({ label: pageLabel });
  }
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f6f7f9" />
  <link rel="icon" href="/logo.png" type="image/png" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="agent-protocol" href="/.well-known/agent.json" type="application/json" />
  <link rel="llms-txt" href="/llms.txt" type="text/plain" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Site index for machines" />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version of this page" />}
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  <!-- Anti-FOUC: light unless the visitor chose dark. Key v2: the old key
       was written on every visit, so it cannot tell a choice from a default. -->
  <script is:inline>
    (function(){var r=document.documentElement;try{
      var t=localStorage.getItem('sw-theme-v2')==='dark'?'dark':'light';
      r.classList.add(t);r.setAttribute('data-theme',t);
    }catch(e){r.classList.add('light');}}());
  </script>
</head>

<body>
  <!-- App shell: a fixed sidebar (desktop) that becomes a top bar + drawer
       below 1024px. <header id="navbar"> is one element in both shapes, so the
       logo, Get Started and the hub links are the same nodes everywhere. -->
  <header id="navbar" class="sw-side">
    <div class="sw-side__brand">
      <a href="/" class="sw-brand" aria-label="Shadow Warden AI — home">
        <img src="/logo.png" alt="Shadow Warden AI" width="74" height="40" />
        <span class="sw-brand__name">Shadow Warden<span class="sw-brand__ai">AI</span></span>
      </a>
    </div>

    <!-- Primary action. First /signup link in the DOM: on mobile it sits in the
         top bar, on desktop CSS order moves it to the foot of the sidebar. -->
    <div class="sw-side__cta">
      <a href="https://portal.shadow-warden-ai.com/register" class="sw-cta">Get Started</a>
      <button id="mobile-btn" type="button" class="sw-iconbtn sw-only-mobile" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg id="icon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="sw-side__nav" aria-label="Primary">
      <ul class="sw-quick">
        {quickLinks.map(q => (
          <li>
            <a href={q.href} class="sw-item" aria-current={isActive(q.href) ? 'page' : undefined}>
              <svg class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon(q.href)} />
              <span class="sw-item__label">{q.label}</span>
              {q.badge && <span class="sw-badge">{q.badge}</span>}
            </a>
          </li>
        ))}
      </ul>

      {categories.map((cat, ci) => {
        const open = isHubActive(cat);
        const listId = `hub-${ci}`;
        return (
          <div class="group sw-hub" data-hub={cat.label} data-open={open ? 'true' : 'false'} style={`--hub:${cat.color}`}>
            <div class="sw-hub__head">
              <a href={cat.href} class="sw-hub__link" aria-current={isActive(cat.href) && currentPath.replace(/(.)\/$/, '$1') === cat.href ? 'page' : undefined}>
                <span class="sw-hub__mark" aria-hidden="true"></span>
                <span class="sw-hub__label">{cat.label}</span>
              </a>
              <button type="button" class="sw-hub__toggle" aria-expanded={open ? 'true' : 'false'} aria-controls={listId} aria-label={`${cat.label} section`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
              </button>
            </div>
            <div class="sw-hub__body" id={listId} data-hub-list>
              <ul class="sw-hub__list">
                {cat.items.map(item => 'divider' in item ? (
                  <li class="sw-sep" role="separator"></li>
                ) : (
                  <li>
                    <a href={item.href} class="sw-item"
                       aria-current={item.href.startsWith('/') && isActive(item.href) && item === activeItem ? 'page' : undefined}
                       {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                      {item.href.startsWith('http')
                        ? <span class="sw-live" aria-hidden="true"></span>
                        : <svg class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon(item.href)} />}
                      <span class="sw-item__label">{item.label.replace(/^●\s*/, '')}</span>
                      {item.href.startsWith('http') && (
                        <svg class="sw-item__ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );
      })}
    </nav>

    <div class="sw-side__foot">
      <div class="sw-foot__row">
        <button id="theme-toggle" type="button" class="sw-item sw-theme" aria-label="Switch colour theme">
          <svg id="tt-moon" class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg id="tt-sun" class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <span class="sw-item__label" id="tt-label">Dark theme</span>
        </button>
        <button id="a11y-nav-btn" type="button" class="sw-iconbtn" aria-label="Accessibility settings">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="4" r="2"/><path d="M12 6v6M6 10h12M9 20l3-8 3 8"/></svg>
        </button>
        <a href="https://github.com/zborrman/Shadow-Warden-AI" target="_blank" rel="noopener" class="sw-iconbtn" aria-label="GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
      </div>

      <a id="nav-signin" href="https://portal.shadow-warden-ai.com/login" class="sw-item">
        <svg class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        <span class="sw-item__label">Sign in</span>
      </a>

      <div id="nav-user" class="sw-user" style="display:none">
        <button id="nav-avatar-btn" type="button" class="sw-item" aria-haspopup="menu">
          <span id="nav-avatar-initials" class="sw-avatar">?</span>
          <span class="sw-item__label"><span id="nav-user-email">Signed in</span></span>
        </button>
        <div id="nav-user-dropdown" class="sw-menu" role="menu" style="display:none">
          <a href="https://portal.shadow-warden-ai.com" role="menuitem" class="sw-item"><span class="sw-item__label">Seller workspace</span></a>
        </div>
        <button id="nav-signout-btn" type="button" class="sw-item sw-item--danger">
          <svg class="sw-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
          <span class="sw-item__label">Sign out</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile drawer — the same table as the sidebar, every hub open. -->
  <div id="mobile-menu" class="sw-drawer hidden" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="sw-drawer__panel">
      <ul class="sw-quick">
        {quickLinks.map(q => (
          <li><a href={q.href} class="sw-item"><span class="sw-item__label">{q.label}</span>{q.badge && <span class="sw-badge">{q.badge}</span>}</a></li>
        ))}
      </ul>
      {categories.map(cat => (
        <div class="sw-hub" data-open="true" style={`--hub:${cat.color}`}>
          <div class="sw-hub__head">
            <a href={cat.href} class="sw-hub__link"><span class="sw-hub__mark" aria-hidden="true"></span><span class="sw-hub__label">{cat.label}</span></a>
          </div>
          <ul class="sw-hub__list">
            {cat.items.map(item => 'divider' in item ? null : (
              <li><a href={item.href} class="sw-item"><span class="sw-item__label">{item.label.replace(/^●\s*/, '')}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="sw-drawer__foot">
        <a href="/settings" class="sw-item"><span class="sw-item__label">Settings</span></a>
        <a id="mobile-signin" href="https://portal.shadow-warden-ai.com/login" class="sw-item"><span class="sw-item__label">Sign in</span></a>
        <button id="mobile-signout" type="button" class="sw-item sw-item--danger" style="display:none"><span class="sw-item__label">Sign out</span></button>
        <button id="mobile-theme" type="button" class="sw-item"><span class="sw-item__label">Switch theme</span></button>
      </div>
    </div>
  </div>

  <div class="sw-main">
    <div id="top-banner" class="sw-banner">
      <a href="/sellers" class="sw-banner__link">
        <span class="sw-banner__tag">New</span>
        <span>For Amazon sellers — check your catalog free</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <button id="banner-close" type="button" class="sw-banner__close" aria-label="Dismiss announcement">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="sw-topbar">
      {crumbs.length > 0 ? (
        <nav aria-label="Breadcrumb" class="sw-crumbs">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {i > 0 && <span class="sw-crumbs__sep" aria-hidden="true">/</span>}
                {c.href
                  ? <a href={c.href}>{c.label}</a>
                  : <span aria-current="page">{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      ) : <span class="sw-topbar__title">Seller protection workspace</span>}
      <div class="sw-topbar__actions">
        <a href="/doc" class="sw-toplink">Docs</a>
        <a href="/contact" id="nav-contact" class="sw-toplink">Contact</a>
        <a href="/status" class="sw-toplink">Status</a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="sw-footer">
      <div class="sw-footer__inner">
        <div class="sw-footer__grid">
          <div class="sw-footer__about">
            <img src="/logo.png" alt="Shadow Warden AI" width="74" height="40" />
            <p>
              A workspace for Amazon sellers: listing, label and account-health risks, found early.
              Independent of Amazon. Data stored in the EU.
            </p>
          </div>
          {[
            { title: 'Product', links: [
              ...categories.map(c => ({ label: c.label, href: c.href })),
              { label: 'Live dashboards', href: LIVE_DASHBOARDS[0].href },
            ]},
            { title: 'Documentation', links: [
              { label: 'Quick Start', href: '/doc/quick-start' },
              { label: 'API Reference', href: '/doc/api-reference' },
              { label: 'Compliance', href: '/doc/compliance' },
              { label: 'Changelog', href: '/doc/changelog' },
            ]},
            { title: 'Legal', links: [
              { label: 'About', href: '/about' },
              { label: 'Trust Center', href: '/trust' },
              { label: 'Terms of Service', href: '/terms' },
              { label: 'Refund Policy', href: '/refund' },
              { label: 'Privacy Notice', href: '/privacy' },
              { label: 'GDPR DPIA', href: '/doc/compliance' },
              // "SOC 2 Type II" alone read as a certification we hold. We hold
              // none: docs/capability-matrix.md rates this SELF-ATTESTED — a
              // control mapping and an evidence collector, which is preparation.
              // The anchor was wrong too (#reports; the section is #tab-reports),
              // so the link never even reached what it named.
              { label: 'SOC 2 readiness', href: '/trust#tab-reports' },
            ]},
          ].map(col => (
            <div>
              <h2 class="sw-footer__title">{col.title}</h2>
              <ul>
                {col.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="sw-footer__base">
          <p>© 2026 Shadow Warden AI. All rights reserved.</p>
          <p>{PRODUCT.display}</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // ── Announcement strip ──
    (function () {
      const BANNER_STORE = 'sw_banner_v52_dismissed';
      const banner = document.getElementById('top-banner');
      if (sessionStorage.getItem(BANNER_STORE) === '1' && banner) banner.style.display = 'none';
      document.getElementById('banner-close')?.addEventListener('click', () => {
        sessionStorage.setItem(BANNER_STORE, '1');
        if (banner) banner.style.display = 'none';
      });
    })();

    // ── Sidebar sections: open/closed survives navigation ──
    (function () {
      const HUBS_STORE = 'sw-hubs';
      let saved: Record<string, boolean> = {};
      try { saved = JSON.parse(localStorage.getItem(HUBS_STORE) || '{}'); } catch { saved = {}; }
      document.querySelectorAll<HTMLElement>('#navbar .sw-hub').forEach(hub => {
        const name = hub.dataset.hub || '';
        const btn = hub.querySelector<HTMLButtonElement>('.sw-hub__toggle');
        const set = (open: boolean) => {
          hub.dataset.open = open ? 'true' : 'false';
          btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        // The hub holding the current page is always open; others follow the visitor.
        if (hub.dataset.open !== 'true' && saved[name]) set(true);
        btn?.addEventListener('click', () => {
          const open = hub.dataset.open !== 'true';
          set(open);
          saved[name] = open;
          try { localStorage.setItem(HUBS_STORE, JSON.stringify(saved)); } catch {}
        });
      });
      document.querySelector('#navbar .sw-item[aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
    })();

    // ── Mobile drawer ──
    const btn = document.getElementById('mobile-btn')!;
    const menu = document.getElementById('mobile-menu')!;
    const iconMenu = document.getElementById('icon-menu')!;
    const iconClose = document.getElementById('icon-close')!;
    function openMenu() {
      menu.classList.remove('hidden');
      iconMenu.style.display = 'none';
      iconClose.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    }
    function closeMenu() {
      menu.classList.add('hidden');
      iconMenu.style.display = 'block';
      iconClose.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }
    btn.addEventListener('click', () => menu.classList.contains('hidden') ? openMenu() : closeMenu());
    menu.addEventListener('click', e => { if (e.target === menu) closeMenu(); });
    document.querySelectorAll('#mobile-menu a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

    document.getElementById('a11y-nav-btn')?.addEventListener('click', () => {
      document.getElementById('a11y-trigger')?.click();
    });

    // ── Theme: light by default, dark only when the visitor picks it ──
    (function () {
      const THEME_STORE = 'sw-theme-v2';
      const sun = document.getElementById('tt-sun');
      const moon = document.getElementById('tt-moon');
      const label = document.getElementById('tt-label');
      const meta = document.querySelector('meta[name="theme-color"]');
      function paint(theme: 'light' | 'dark') {
        const root = document.documentElement;
        root.classList.remove('dark', 'light');
        root.classList.add(theme);
        root.setAttribute('data-theme', theme);
        if (sun && moon) {
          sun.style.display = theme === 'dark' ? '' : 'none';
          moon.style.display = theme === 'light' ? '' : 'none';
        }
        if (label) label.textContent = theme === 'dark' ? 'Light theme' : 'Dark theme';
        meta?.setAttribute('content', theme === 'dark' ? '#070910' : '#f6f7f9');
      }
      function flip() {
        const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        try { localStorage.setItem(THEME_STORE, next); } catch {}
        const swap = () => paint(next);
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(swap);
        else swap();
      }
      paint(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
      document.getElementById('theme-toggle')?.addEventListener('click', flip);
      document.getElementById('mobile-theme')?.addEventListener('click', flip);
    })();

    // ── Auth state — read sw_logged_in indicator cookie (no API call needed) ──
    // sw_logged_in is a non-HttpOnly Secure=Lax cookie set alongside sw_session on login/signup.
    // It never carries the JWT; it only signals "a session exists".
    (function () {
      const signin = document.getElementById('nav-signin');
      const userWidget = document.getElementById('nav-user');
      const avatarBtn = document.getElementById('nav-avatar-btn');
      const dropdown = document.getElementById('nav-user-dropdown');
      const signoutBtn = document.getElementById('nav-signout-btn');
      const mSignin = document.getElementById('mobile-signin');
      const mSignout = document.getElementById('mobile-signout');
      const isLoggedIn = document.cookie.split(';').some(c => c.trim() === 'sw_logged_in=1');
      if (isLoggedIn) {
        if (signin) signin.style.display = 'none';
        if (userWidget) userWidget.style.display = 'block';
        if (mSignin) mSignin.style.display = 'none';
        if (mSignout) mSignout.style.display = '';
      }
      avatarBtn?.addEventListener('click', e => {
        e.stopPropagation();
        if (dropdown) dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
      });
      document.addEventListener('click', () => { if (dropdown) dropdown.style.display = 'none'; });
      async function doSignOut() {
        try { await fetch('/api/auth/logout', { method: 'POST' }); } catch {}
        window.location.href = '/';
      }
      signoutBtn?.addEventListener('click', doSignOut);
      mSignout?.addEventListener('click', () => { closeMenu(); doSignOut(); });
    })();

    // ── Scroll-reveal ──
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-in-section').forEach(el => io.observe(el));
    })();
  </script>

  <!-- Accessibility widget — fixed bottom-right, on every page -->
  <AccessibilityWidget />
</body>
</html>
