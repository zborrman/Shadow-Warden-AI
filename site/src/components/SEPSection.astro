---
const sepFeatures = [
  {
    icon: '🆔', color: '#b45309', title: 'UECIID — Universal Entity ID',
    file: 'communities/sep.py',
    desc: 'SEP-{11 base-62 chars} encodes 64-bit Snowflake ID. Case-sensitive alphabet 0-9A-Za-z. Lexicographic = chronological. Globally unique business identity.',
    badge: 'SEP-aBcDeFgHiJk',
  },
  {
    icon: '🤝', color: '#c2410c', title: 'Inter-Community Peering',
    file: 'communities/peering.py',
    desc: 'MIRROR_ONLY / REWRAP_ALLOWED / FULL_SYNC policies. HMAC handshake token stored as hash only. Duplicate ACTIVE peering blocked. Transfer velocity tracking.',
    badge: 'HMAC Handshake',
  },
  {
    icon: '🚪', color: '#2563eb', title: 'Knock-and-Verify',
    file: 'communities/knock.py',
    desc: 'One-time invitation tokens. Redis sep:knock:{hash} (72h TTL). verify_and_accept_knock() asserts invitee_tenant_id. Auto-promotes to member on accept.',
    badge: '72h TTL · One-time',
  },
  {
    icon: '🛡️', color: '#be123c', title: 'Causal Transfer Guard',
    file: 'communities/transfer_guard.py',
    desc: 'Bayesian risk gate on every transfer. Maps data_class + velocity + peering age → arbitrate() evidence. Blocks exfiltration at P≥0.70 before the transfer proceeds. Redis sliding window.',
    badge: 'P≥0.70 BLOCK',
  },
  {
    icon: '🗄️', color: '#15803d', title: 'Sovereign Data Pods',
    file: 'communities/data_pod.py',
    desc: 'Per-jurisdiction MinIO routing. Fernet-encrypted secret keys (SHA-256 of COMMUNITY_VAULT_KEY). Resolution: jurisdiction → data_class → primary → first ACTIVE.',
    badge: 'Fernet AES-128',
  },
  {
    icon: '📜', color: '#9333ea', title: 'STIX 2.1 Audit Chain',
    file: 'communities/stix_audit.py',
    desc: 'Tamper-evident blockchain-style chain. Genesis block prev_hash = "0"×64. verify_chain() re-hashes canonical JSON. JSONL export for SIEM import.',
    badge: 'SHA-256 Chain',
  },
];

const transferFlow = [
  { label: 'transfer_entity()', color: '#b45309' },
  { label: 'resolve pod tag → data_class', color: '#c2410c' },
  { label: 'evaluate_transfer_risk()', color: '#be123c' },
  { label: 'P < 0.70?', color: '#2563eb', branch: true },
  { label: 'sign CTP (HMAC + PQC)', color: '#9333ea' },
  { label: 'stix_audit.append_transfer()', color: '#15803d' },
  { label: 'new UECIID in target community', color: '#15803d' },
];
---

<section id="sep" class="relative py-24 lg:py-32 bg-[var(--sw-bg)]">
  <div class="absolute inset-x-0 top-0 h-px"
       style="background:linear-gradient(90deg,transparent,rgba(255,215,10,0.2),transparent)"></div>

  <!-- Gold ambient -->
  <div class="absolute top-0 left-0 w-[700px] h-[500px] pointer-events-none"
       style="background:radial-gradient(ellipse at top left,rgba(255,215,10,0.04) 0%,transparent 70%)"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-16">
      <p class="text-[11px] font-bold tracking-[2.5px] uppercase text-[color:var(--acc-amber)] mb-3">
        SEP — Syndicate Exchange Protocol
      </p>
      <h2 class="text-[42px] lg:text-[56px] font-black tracking-[-2.5px] leading-[1.0] mb-4">
        Secure business<br />
        <span style="background:linear-gradient(135deg,var(--acc-amber),var(--acc-amber));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
          document exchange.
        </span>
      </h2>
      <p class="text-[16px] text-[color:var(--ink-3)] max-w-xl leading-relaxed">
        Cryptographically-attested inter-community protocol. Every entity transfer gets
        a Causal Transfer Proof, PQC signature, and STIX 2.1 audit chain entry.
      </p>
    </div>

    <!-- Feature cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {sepFeatures.map(f => (
        <div class="rounded-xl border border-white/[0.06] bg-[var(--sw-bg)] p-5
                    hover:border-opacity-50 hover:-translate-y-0.5 transition-all duration-200">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0"
                 style={`background:${f.color}15`}>{f.icon}</div>
            <div>
              <div class="text-[13px] font-bold">{f.title}</div>
              <div class="text-[8px] font-mono text-[color:var(--ink-5)] mt-0.5">{f.file}</div>
            </div>
          </div>
          <p class="text-[11px] text-[color:var(--ink-3)] leading-[1.65] mb-3">{f.desc}</p>
          <span class="text-[9px] font-mono font-bold px-2.5 py-1 rounded-md"
                style={`color:${f.color};background:${f.color}15`}>{f.badge}</span>
        </div>
      ))}
    </div>

    <!-- Transfer flow + 24 API endpoints -->
    <div class="grid lg:grid-cols-[1fr_300px] gap-6">

      <!-- Transfer flow -->
      <div class="rounded-2xl border border-white/[0.06] bg-[var(--sw-bg)] p-6">
        <div class="text-[12px] font-bold text-[color:var(--ink-5)] uppercase tracking-wider mb-5">
          Entity Transfer Flow
        </div>
        <div class="flex flex-col gap-0">
          {transferFlow.map((step, i) => (
            <div class="flex items-center gap-3">
              <div class="flex flex-col items-center">
                <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0"
                     style={`background:${step.color}20;color:${step.color}`}>{i + 1}</div>
                {i < transferFlow.length - 1 && <div class="w-px h-4 my-0.5" style={`background:${step.color}30`}></div>}
              </div>
              <div class={`text-[12px] py-1 ${step.branch ? 'font-bold' : ''}`}
                   style={step.branch ? `color:${step.color}` : 'color:var(--ink-1)'}>
                {step.label}
                {step.branch && (
                  <span class="ml-2 text-[9px] text-[color:var(--acc-red)]">→ REJECTED if P≥0.70</span>
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-4 pt-4 border-t border-white/[0.05] text-[10px] text-[color:var(--ink-3)]">
          REJECTED transfers still written to sep_transfers table and STIX chain — full audit trail preserved.
          Proof includes optional ML-DSA-65 pqc_signature when source community is_hybrid=True.
        </div>
      </div>

      <!-- 24 endpoints -->
      <div class="rounded-2xl border border-white/[0.06] bg-[var(--sw-bg)] p-6">
        <div class="text-[12px] font-bold text-[color:var(--ink-5)] uppercase tracking-wider mb-4">
          24 REST Endpoints · /sep/*
        </div>
        <div class="flex flex-col gap-1.5">
          {[
            ['POST', '/sep/ueciid', 'var(--acc-green)'],
            ['GET',  '/sep/ueciid/{id}', 'var(--acc-blue-2)'],
            ['GET',  '/sep/ueciid/search', 'var(--acc-blue-2)'],
            ['GET',  '/sep/ueciid/list', 'var(--acc-blue-2)'],
            ['PUT',  '/sep/pod-tags/{id}', 'var(--acc-amber)'],
            ['GET',  '/sep/pod-tags/{id}', 'var(--acc-blue-2)'],
            ['POST', '/sep/peerings', 'var(--acc-green)'],
            ['POST', '/sep/peerings/{id}/accept', 'var(--acc-amber)'],
            ['POST', '/sep/peerings/{id}/transfer', 'var(--acc-red)'],
            ['POST', '/sep/transfers/{id}/verify-proof', 'var(--acc-violet)'],
            ['POST', '/sep/knock/issue', 'var(--acc-green)'],
            ['POST', '/sep/knock/accept', 'var(--acc-amber)'],
            ['POST', '/sep/pods', 'var(--acc-green)'],
            ['GET',  '/sep/pods/{id}', 'var(--acc-blue-2)'],
            ['POST', '/sep/pods/{id}/probe', 'var(--acc-amber)'],
            ['GET',  '/sep/audit-chain/{id}', 'var(--acc-blue-2)'],
            ['POST', '/sep/audit-chain/{id}/verify', 'var(--acc-violet)'],
            ['GET',  '/sep/audit-chain/{id}/export', 'var(--acc-cyan)'],
          ].map(([method, path, color]) => (
            <div class="flex items-center gap-2">
              <span class="text-[8px] font-bold w-10 text-right flex-shrink-0"
                    style={`color:${color}`}>{method}</span>
              <span class="text-[9px] font-mono text-[color:var(--ink-3)] truncate">{path}</span>
            </div>
          ))}
          <div class="text-[9px] text-[color:var(--ink-5)] mt-1">+ 6 more (knock revoke/list, pod delete...)</div>
        </div>
      </div>
    </div>
  </div>
</section>
