---
// Each OWASP LLM vector is mapped to the layer that handles it. This is a
// mapping, not a measured coverage figure — see docs/capability-matrix.md §1.
// The per-vector percentages that used to sit here were not produced by any
// test or benchmark, and are gone.
const owasp = [
  { id: 'LLM01', name: 'Prompt Injection',          layer: 'SemanticGuard + Brain' },
  { id: 'LLM02', name: 'Insecure Output Handling',  layer: 'OutputGuard v2' },
  { id: 'LLM03', name: 'Training Data Poisoning',   layer: 'Evolution Engine Guard' },
  { id: 'LLM04', name: 'Model Denial of Service',   layer: 'ERS Shadow Ban' },
  { id: 'LLM05', name: 'Supply Chain Vuln.',        layer: 'Dependency CVE Scanner' },
  { id: 'LLM06', name: 'Sensitive Info Disclosure', layer: 'PII Vault + Redactor' },
  { id: 'LLM07', name: 'Insecure Plugin Design',    layer: 'Agent Monitor' },
  { id: 'LLM08', name: 'Excessive Agency',          layer: 'Agent Sandbox' },
  { id: 'LLM09', name: 'Overreliance',              layer: 'Causal Arbiter' },
  { id: 'LLM10', name: 'Model Theft',               layer: 'PQC + Evidence Vault' },
];

// We hold no certification of any kind. Every row below is our own mapping of
// our own controls, and says so. Never relabel these as certifications.
const frameworks = [
  { icon: '🇪🇺', name: 'GDPR Art.35 DPIA',   note: 'published',     color: 'text-[#0A84FF]' },
  { icon: '🔐', name: 'SOC 2 Type II',       note: 'preparing',     color: 'text-[#8E8E9E]' },
  { icon: '🏛️', name: 'EU AI Act',           note: 'self-assessed', color: 'text-[#8E8E9E]' },
  { icon: '🧬', name: 'NIST FIPS 203/204',   note: 'algorithms',    color: 'text-[#BF5AF2]' },
  { icon: '🏥', name: 'HIPAA PHI controls',  note: 'mapped',        color: 'text-[#8E8E9E]' },
  { icon: '🌐', name: 'ISO 27001:2022',      note: '93 mapped',     color: 'text-[#8E8E9E]' },
];
---

<section id="compliance" class="relative py-28 lg:py-36 bg-[#080D1E]">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/[0.07] to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/[0.07] to-transparent"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-16">
      <p class="text-[11px] font-bold tracking-[2.5px] uppercase text-[#30D158] mb-3">
        Compliance & control mappings
      </p>
      <h2 class="text-[42px] lg:text-[52px] font-bold tracking-[-2px] mb-4">
        All ten OWASP LLM vectors, mapped to a defense layer.
      </h2>
      <p class="text-[16px] text-[#8E8E9E] max-w-xl leading-relaxed">
        A mapping, not a coverage score. Our measured result on our own
        58-prompt adversarial corpus is <span class="text-[#F5F5F7] font-semibold">36.2%
        caught at HIGH or BLOCK, with zero false positives</span> across 35 benign
        prompts — reproduce it with <code class="text-[12px] text-[#8E8E9E]">scripts/capability_probe.py</code>.
        We publish the number because closing the gap is on the roadmap and
        hiding it would not be.
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_340px] gap-12">
      <!-- OWASP table -->
      <div class="rounded-2xl border border-white/[0.07] overflow-hidden">
        <div class="grid grid-cols-[80px_1fr_160px] px-5 py-3 border-b border-white/[0.07] bg-[#0D1428]">
          {['ID', 'Vulnerability', 'Defense Layer'].map(h => (
            <span class="text-[9px] font-bold tracking-[1.5px] uppercase text-[#48485A]">{h}</span>
          ))}
        </div>
        {owasp.map((row, i) => (
          <div
            class={`grid grid-cols-[80px_1fr_160px] items-center px-5 py-3.5 text-[13px]
                   ${i < owasp.length - 1 ? 'border-b border-white/[0.05]' : ''}
                   hover:bg-white/[0.02] transition-colors duration-150`}
          >
            <span
              class="font-mono text-[11px] font-bold px-2 py-0.5 rounded
                     bg-[#30D158]/10 text-[#30D158] w-fit"
            >{row.id}</span>
            <span class="text-[#F5F5F7] font-medium pr-4">{row.name}</span>
            <span class="text-[11px] text-[#8E8E9E]">{row.layer}</span>
          </div>
        ))}
      </div>

      <!-- Frameworks + Evidence Vault -->
      <div class="flex flex-col gap-6">
        <!-- Frameworks -->
        <div class="rounded-2xl border border-white/[0.07] p-6 bg-[#0D1428]">
          <h3 class="text-[13px] font-bold mb-1 text-[#8E8E9E] uppercase tracking-wider">
            Control mappings
          </h3>
          <p class="text-[11px] text-[#48485A] mb-4 leading-relaxed">
            Self-attested. We hold no third-party certification.
          </p>
          <div class="flex flex-col gap-3">
            {frameworks.map(f => (
              <div class="flex items-center gap-3">
                <span class="text-lg">{f.icon}</span>
                <span class={`text-[13px] font-medium ${f.color}`}>{f.name}</span>
                <span class="ml-auto text-[10px] font-mono text-[#48485A]">{f.note}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Evidence Vault -->
        <div class="rounded-2xl border border-[#30D158]/20 p-6 bg-[#30D158]/[0.04]">
          <div class="text-2xl mb-3">🔒</div>
          <h3 class="text-[15px] font-bold mb-2">Litigation-Ready Evidence Vault</h3>
          <p class="text-[13px] text-[#8E8E9E] leading-relaxed mb-4">
            Every decision backed by SHA-256 attestation chains stored in MinIO.
            STIX 2.1 tamper-evident audit chain. PDF reports on demand.
          </p>
          <div class="flex gap-2 flex-wrap">
            <span class="text-[9px] font-bold uppercase tracking-wider
                        px-2.5 py-1 rounded bg-[#30D158]/10 text-[#30D158]">
              SHA-256 Chain
            </span>
            <span class="text-[9px] font-bold uppercase tracking-wider
                        px-2.5 py-1 rounded bg-[#30D158]/10 text-[#30D158]">
              STIX 2.1
            </span>
            <span class="text-[9px] font-bold uppercase tracking-wider
                        px-2.5 py-1 rounded bg-[#30D158]/10 text-[#30D158]">
              PDF Export
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
