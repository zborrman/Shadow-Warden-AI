---
import { PRODUCT } from '../../data/product';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Every statement on this page is bounded by the "M2M Store" rows of
// docs/capability-matrix.md. Change the row first, then the copy.
const PORTAL = 'https://portal.shadow-warden-ai.com';

const audiences = [
  {
    icon: '🧱', title: 'For sellers',
    points: [
      'Build the shop in the portal: categories nested up to five levels, products, photos.',
      'A price per currency, set by you: no exchange rates applied behind your back.',
      'Product names and descriptions in English, French, German, Spanish and Italian.',
      'Shipping zones by country, with a free-shipping threshold and an optional import-duty estimate.',
    ],
  },
  {
    icon: '🛒', title: 'For people',
    points: [
      'Your storefront at portal.shadow-warden-ai.com/s/your-store, in the buyer’s language.',
      'Buyers pick currency and metric or imperial units; shipping is quoted for their country.',
      'They send an order request with their address. You accept, decline, ship and complete it.',
      'A private link lets the buyer follow the request and cancel it until you answer.',
    ],
  },
  {
    icon: '🤖', title: 'For AI agents',
    points: [
      'A UCP-format catalog feed per store, readable without an account.',
      'Offers reserve stock for 45 seconds, so two agents cannot buy the last item twice.',
      'An agent order needs the buying tenant’s passkey on that exact offer.',
      'Spend is checked against the buyer’s mandate and written to the STIX audit chain.',
    ],
  },
];

const limits = [
  ['The platform takes no payments.', 'The buyer pays you directly, through your own payment link or bank details. We never see or hold the money, so a refund or chargeback is yours to handle. Card payments on the storefront and platform payouts are not built.'],
  ['“Paid” is your word.', 'You mark an order paid. Nothing here checks that the money arrived.'],
  ['“AP2” is spend accounting.', 'For agent orders it debits the remaining balance of the buyer’s mandate in our own ledger. No money moves between accounts.'],
  ['Import duty is your estimate.', 'Buyers see it as an estimate, outside the order total. Customs sets the real amount.'],
  ['No stores are open yet.', 'The builder and storefront are deployed. No seller has opened a store yet.'],
];

const groups = [
  {
    title: 'Builder: your session or API key',
    rows: [
      ['POST', '/m2m-store/stores', 'Create a store: slug, currencies, languages.'],
      ['POST', '/m2m-store/stores/{id}/categories', 'Add a category; parent_id nests it.'],
      ['POST', '/m2m-store/products', 'Create or update a product.'],
      ['PUT', '/m2m-store/products/{id}/prices', 'Set one price per currency, in minor units.'],
      ['PUT', '/m2m-store/products/{id}/translations/{locale}', 'Name and description in one language.'],
      ['POST', '/m2m-store/products/{id}/images', 'Upload a photo (JPEG, PNG or WebP).'],
      ['POST', '/m2m-store/stores/{id}/shipping-zones', 'Countries, rate, free-over threshold, duty estimate.'],
      ['GET', '/m2m-store/stores/{id}/order-requests', 'Order requests with the buyer’s contact details.'],
      ['PATCH', '/m2m-store/order-requests/{id}', 'Accept, decline, mark paid, ship or complete, with a note.'],
      ['PUT', '/m2m-store/order-requests/{id}/payment-link', 'Attach your own payment page to an accepted request.'],
    ],
  },
  {
    title: 'Storefront: anonymous, rate-limited',
    rows: [
      ['GET', '/m2m-store/storefront/{slug}', 'Store name, currencies, languages, categories.'],
      ['GET', '/m2m-store/storefront/{slug}/catalog/ucp', 'Products with prices, stock, translations, photos.'],
      ['GET', '/m2m-store/storefront/{slug}/shipping/quote', 'Shipping and duty estimate for a country and currency.'],
      ['POST', '/m2m-store/storefront/{slug}/order-requests', 'Send an order request (5 per minute per address).'],
      ['GET', '/m2m-store/storefront/{slug}/order-requests/{id}', 'Follow a request; needs its X-Order-Token.'],
    ],
  },
  {
    title: 'Agents: API key',
    rows: [
      ['POST', '/m2m-store/offers', 'Request a priced offer; reserves the stock.'],
      ['POST', '/m2m-store/offers/{id}/challenge', 'WebAuthn options bound to this offer.'],
      ['POST', '/m2m-store/orders', 'Order with the passkey assertion and a mandate id.'],
      ['GET', '/m2m-store/orders/{id}', 'Order status.'],
    ],
  },
];

const security = [
  ['🏷️', 'Tenant isolation', 'Every store, product and order row carries its owner’s tenant. A request for another tenant’s data answers 404.'],
  ['🔐', 'Contact details sealed', 'Buyer addresses are encrypted at rest and never logged. Webhooks to the seller carry only ids and amounts.'],
  ['🔑', 'Passkey per offer', 'A challenge is good for one offer and is consumed before the signature is checked, so an approval cannot be replayed.'],
  ['💶', 'Server-side prices', 'Totals are recomputed from your prices and zones; whatever the browser sends is ignored.'],
  ['⏱️', 'Rate limits', 'Storefront reads, order requests and agent calls each have a per-caller limit and answer 429 beyond it.'],
  ['🛡️', 'Input screening', 'Agent request strings are checked against injection patterns; free text is length-capped.'],
];
---

<BaseLayout
  title="M2M Commerce Store — Shadow Warden AI"
  description="A multilingual, multi-currency shop builder that people and AI agents can buy from. Order requests today; no payments are taken on the platform."
>
<div class="bg-[#03050F] text-[#F5F5F7] min-h-screen" style="font-family:'Inter',system-ui,sans-serif">
  <div class="max-w-[1100px] mx-auto px-6 pt-8 pb-20">

    <!-- Hero -->
    <div class="mb-14 pb-12 border-b border-white/[0.07]">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 mb-6 text-[12px] text-[#94a3b8]">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/business-community" class="hover:text-white transition-colors">Business Community</a>
        <span aria-hidden="true">/</span>
        <span class="text-[#FFD60A]" aria-current="page">M2M Store</span>
      </nav>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-5xl" aria-hidden="true">🏪</span>
        <div>
          <div class="text-[11px] font-semibold tracking-[2px] uppercase text-[#FFD60A]">Shadow Warden AI · {PRODUCT.display}</div>
          <div class="text-[12px] text-[#94a3b8]">Machine-to-Machine Commerce</div>
        </div>
      </div>
      <h1 class="text-[36px] lg:text-[48px] font-black tracking-[-2px] mb-4">M2M Commerce Store</h1>
      <p class="text-[16px] leading-relaxed max-w-[680px] mb-6" style="color:#b6c2d4">
        A shop builder for one storefront that both people and AI agents can buy from. Prices in each
        currency you choose, five languages, and shipping by country. People send order requests; agents
        order under a spending mandate and the buyer’s passkey.
      </p>
      <p class="inline-block rounded-lg border px-3 py-2 text-[13px]"
         style="color:#fde68a;border-color:rgba(251,191,36,0.3);background:rgba(251,191,36,0.06)">
        No payments are taken on the platform: buyers pay you directly, through your own payment link.
      </p>
    </div>

    <!-- Audiences -->
    <section aria-labelledby="who" class="mb-16">
      <h2 id="who" class="text-[22px] font-bold mb-6">What it does</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {audiences.map(a => (
          <div class="rounded-xl p-5 border" style="background:rgba(255,215,10,0.04);border-color:rgba(255,215,10,0.15)">
            <div class="text-2xl mb-2" aria-hidden="true">{a.icon}</div>
            <h3 class="text-[15px] font-bold mb-3">{a.title}</h3>
            <ul class="space-y-2 text-[13px] leading-relaxed" style="color:#b6c2d4">
              {a.points.map(p => <li class="pl-3 border-l border-white/10">{p}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Limits -->
    <section aria-labelledby="limits" class="mb-16">
      <h2 id="limits" class="text-[22px] font-bold mb-6">What it does not do yet</h2>
      <dl class="grid sm:grid-cols-2 gap-4">
        {limits.map(([t, d]) => (
          <div class="rounded-xl border border-white/[0.07] p-5" style="background:rgba(255,255,255,0.02)">
            <dt class="text-[14px] font-bold mb-1">{t}</dt>
            <dd class="text-[13px] leading-relaxed" style="color:#b6c2d4">{d}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Flows -->
    <section aria-labelledby="flows" class="mb-16">
      <h2 id="flows" class="text-[22px] font-bold mb-6">How an order moves</h2>
      <div class="grid lg:grid-cols-2 gap-4">
        <figure class="rounded-2xl border border-white/[0.07] p-6" style="background:rgba(255,255,255,0.02)">
          <figcaption class="text-[13px] font-bold mb-3">A person</figcaption>
          <pre class="text-[12px] leading-relaxed overflow-x-auto" style="color:#b6c2d4;font-family:'JetBrains Mono',monospace">{`Cart → shipping quote for the country
     → order request (contact details sealed)
     → PENDING_MERCHANT
          ├─ seller declines  → REJECTED
          ├─ buyer cancels    → CANCELLED
          └─ seller accepts   → ACCEPTED   (stock taken)
                → PAID (the seller's word) → SHIPPED → COMPLETED
Payment: the buyer pays the seller directly, through the seller's
own link. The seller marks the order paid.`}</pre>
        </figure>
        <figure class="rounded-2xl border border-white/[0.07] p-6" style="background:rgba(255,255,255,0.02)">
          <figcaption class="text-[13px] font-bold mb-3">An agent</figcaption>
          <pre class="text-[12px] leading-relaxed overflow-x-auto" style="color:#b6c2d4;font-family:'JetBrains Mono',monospace">{`UCP feed → offer (stock reserved 45 s)
  → passkey challenge for that offer
  → order: assertion verified, challenge consumed
  → spend authorization + mandate balance
  → stock committed → STIX audit entry
No funds move: the mandate balance is
accounting, not a payment.`}</pre>
        </figure>
      </div>
    </section>

    <!-- API -->
    <section aria-labelledby="api" class="mb-16">
      <h2 id="api" class="text-[22px] font-bold mb-4">API reference</h2>
      <p class="text-[13px] mb-5" style="color:#b6c2d4">
        A selection. The full list is in the <a href="/openapi.json" class="text-[#FFD60A] hover:underline">OpenAPI document</a>.
      </p>
      <div class="space-y-6">
        {groups.map(g => (
          <div>
            <h3 class="text-[14px] font-bold mb-2">{g.title}</h3>
            <div class="rounded-xl border border-white/[0.07] overflow-hidden">
              {g.rows.map(([method, path, desc], i) => (
                <div class={`flex flex-wrap items-start gap-x-4 gap-y-1 px-5 py-3 text-[12px] ${i % 2 === 0 ? 'bg-white/[0.01]' : ''} ${i < g.rows.length - 1 ? 'border-b border-white/[0.05]' : ''}`}>
                  <span class={`font-black w-12 flex-shrink-0 text-[10px] ${method === 'GET' ? 'text-[#30D158]' : 'text-[#FFD60A]'}`}>{method}</span>
                  <code class="text-[#d4a5f9] break-all sm:w-80 sm:flex-shrink-0">{path}</code>
                  <span class="min-w-0 flex-1" style="color:#b6c2d4">{desc}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Security -->
    <section aria-labelledby="security" class="mb-16">
      <h2 id="security" class="text-[22px] font-bold mb-4">Security</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {security.map(([icon, title, desc]) => (
          <div class="rounded-xl border border-white/[0.07] p-5" style="background:rgba(255,255,255,0.02)">
            <div class="text-2xl mb-3" aria-hidden="true">{icon}</div>
            <h3 class="text-[14px] font-bold mb-2">{title}</h3>
            <p class="text-[12px] leading-relaxed" style="color:#b6c2d4">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="rounded-2xl border border-[#FFD60A]/25 p-8 text-center" style="background:rgba(255,215,10,0.04)">
      <h2 class="text-[24px] font-bold mb-3">Open your store</h2>
      <p class="text-[14px] max-w-lg mx-auto mb-6" style="color:#b6c2d4">
        Every plan can open a store, including the free Starter plan.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={`${PORTAL}/store/manage/`}
           class="inline-block px-8 py-3 rounded-xl text-[14px] font-bold hover:-translate-y-0.5 transition-all"
           style="background:#FFD60A;color:#03050F;box-shadow:0 8px 32px rgba(255,215,10,0.3)">
          Open the store builder
        </a>
        <a href="/price" class="inline-block px-8 py-3 rounded-xl text-[14px] font-bold border border-white/15 hover:bg-white/5">
          Compare plans
        </a>
      </div>
    </div>

  </div>
</div>
</BaseLayout>
