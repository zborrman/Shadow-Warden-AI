---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Renders the Redoc API explorer inline — no redirect to docs.shadow-warden-ai.com needed.
// It sits inside BaseLayout like every other page, so the site navigation stays
// on screen while you read the reference.
---
<BaseLayout
  title="API Reference — Shadow Warden AI"
  description="Shadow Warden AI REST API — interactive documentation powered by Redoc. 80+ endpoints."
>
  <div id="redoc-container" style="min-height:100vh;background:#03050f"></div>

  <!-- is:inline prevents Astro/Vite from processing these as ES modules,
       which would break Redoc's UMD global registration. -->
  <script is:inline>
    (function () {
      var s = document.createElement("script");
      s.src = "https://cdn.jsdelivr.net/npm/redoc@2.1.5/bundles/redoc.standalone.js";
      s.onload = function () {
        Redoc.init(
          "/openapi.json",
          {
            theme: {
              colors: {
                primary: { main: "#80b4fd" },
                success: { main: "#10b981" },
                warning: { main: "#f59e0b" },
                error:   { main: "#ef4444" },
                text: { primary: "#e2e8f0", secondary: "#94a3b8" },
                border: { dark: "rgba(255,255,255,0.08)", light: "rgba(255,255,255,0.08)" },
                responses: {
                  success: { color: "#10b981", backgroundColor: "#022c22" },
                  error:   { color: "#ef4444", backgroundColor: "#2d0a0a" },
                },
                http: {
                  get: "#10b981", post: "#80b4fd", put: "#f59e0b",
                  delete: "#ef4444", patch: "#38bdf8",
                },
              },
              typography: {
                fontSize: "14px",
                lineHeight: "1.6",
                fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                headings: {
                  fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                  fontWeight: "700",
                },
                code: {
                  fontSize: "13px",
                  fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
                },
              },
              sidebar: { width: "280px", backgroundColor: "#080910", textColor: "#94a3b8" },
              rightPanel: { backgroundColor: "#050610" },
              schema: { nestedBackground: "#080910" },
            },
            // The site header is fixed and its height changes when the top banner
            // is dismissed, so measure it instead of hard-coding a number.
            scrollYOffset: function () {
              var nav = document.getElementById("navbar");
              return nav ? nav.getBoundingClientRect().bottom : 0;
            },
            hideDownloadButton: false,
            expandDefaultServerVariables: true,
            requiredPropsFirst: true,
            menuToggle: true,
            jsonSampleExpandLevel: 2,
            hideSingleRequestSampleTab: true,
            nativeScrollbars: false,
            disableSearch: false,
          },
          document.getElementById("redoc-container")
        );
      };
      document.head.appendChild(s);
    })();
  </script>
</BaseLayout>
