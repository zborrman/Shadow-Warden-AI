---
import BaseLayout from '../layouts/BaseLayout.astro';
import LemonSqueezyCheckout from '../components/LemonSqueezyCheckout.astro';
import { VARIANT_IDS, BILLING_PORTAL, checkoutUrl } from '../config/lemonsqueezy';
import roadmapData from '../data/roadmap.json';

const bl20 = roadmapData.find((r: any) => r.id === 'BL-20')!;

const tiers = [
  {
    key: 'starter',
    name: 'Starter',
    price_monthly: 0,
    price_annual: 0,
    color: '#556072',
    tint: 'rgba(100,116,139,0.08)',
    tag: null,
    highlight: false,
    cta: 'Get Started Free',
    features: ['1,000 req / month','Basic 9-layer pipeline','1 tenant','Community support','Streamlit dashboard'],
    missing: ['XAI Reports','Evolution Engine','MasterAgent SOC','Sovereign Cloud','Secrets Vault'],
  },
  {
    key: 'individual',
    name: 'Individual',
    price_monthly: 5,
    price_annual: 51,
    color: '#047857',
    tint: 'rgba(16,185,129,0.08)',
    tag: null,
    highlight: false,
    cta: 'Start Free Trial',
    features: ['5,000 req / month','Full 9-layer pipeline','PII & Secret Redaction','Streamlit dashboard','Email support','14-day free trial'],
    addons: ['XAI Reports add-on available'],
    missing: ['MasterAgent SOC','Evolution Engine'],
  },
  {
    key: 'communityBusiness',
    name: 'Community Business',
    price_monthly: 39.99,
    price_annual: 407.90,
    color: '#0369a1',
    tint: 'rgba(128,180,253,0.08)',
    tag: 'Teams',
    highlight: false,
    cta: 'Start Free Trial',
    features: ['15,000 req / month','Everything in Individual','Obsidian Plugin','Secrets Governance','3 communities × 10 members','180-day log retention','14-day free trial'],
  },
];

// Add-on availability by tier, for the cost calculator. Rank = index in `tiers`.
const ADDON_MIN_RANK: Record<string, number> = {
  'Individual+': 1, 'Community Biz+': 2,
};

const addons = [
  // ── Individual+ ──────────────────────────────────────────────────────────
  { key: 'addonXai',         name: 'XAI Audit Reports',        price: 9,  tier: 'Individual+',      desc: '9-stage causal chain. Primary cause attribution. PDF reports for SOC 2 evidence.' },
  { key: 'addonSecretsVault',name: 'Secrets Vault',            price: 12, tier: 'Individual+',      desc: 'Multi-cloud vault connectors. SQLite inventory, lifecycle alerts, policy score.' },
  { key: 'addonSmbSuite',    name: 'SMB Governance Suite',     price: 29, tier: 'Individual+',      desc: 'Vendor Governance, Incident Register, Prompt Library, Training Records, Cost Allocation, Supplier Risk + SMB Suite Wizard.', bullets: ['AI Vendor Register + DPA expiry alerts (BL-22)', 'Cost Allocation + Budget Dashboard (BL-23/24)', 'Incident Register with STIX linkage (CM-35)', 'Supplier AI Risk Assessment (CM-36)', 'Shared Prompt Library with injection screening (CM-37)', 'Employee Training Records HMAC-attested (CM-38)', 'One-wizard provisioning via /smb-suite/provision (IN-25)'] },
  { key: 'addonObsidian',    name: bl20.feature.replace('Add-on: ','').replace(/ — .*/, ''), price: bl20.price, tier: bl20.tier, desc: bl20.description, planned: true, id: bl20.id,
    bullets: ['Advanced scan scheduler (configurable interval)', 'Offline publish queue + local validation', 'XAI pipeline visualization inside Obsidian', 'Dataview security dashboard for notes', 'Frontmatter auto-tagging + WardenSidebarView'] },
  // ── Community Biz+ ───────────────────────────────────────────────────────
  { key: 'addonSeats',       name: 'Extra Seats (+5)',         price: 9,  tier: 'Community Biz+',   desc: 'Stackable. Combine with any higher tier for unlimited seat expansion.' },
  { key: 'addonAgenticPack', name: 'Agentic Commerce Pack',   price: 15, tier: 'Community Biz+',   desc: 'AI procurement with mandate controls, UCP store discovery, AP2 payment execution, MCP agent intents, vendor validation, and BI spend analytics.' },
  { key: 'addonEdgePacks',   name: 'ARC Edge Agent Packs',    price: 15, tier: 'Community Biz+',   desc: 'Plug-and-play edge analytics agents: Crop Health Monitor (NDVI), Yield Optimizer, Disease Detector (Claude Vision). Deploy as marketplace agents.' },
];

// Checkout URL per plan and billing period, read by the configurator script.
const planUrls = Object.fromEntries(tiers.map(t => {
  const v = VARIANT_IDS[t.key];
  const url = (id: string) => id === 'contact' ? 'mailto:sales@shadow-warden-ai.com' : id ? checkoutUrl(id, { embed: true }) : '';
  return [t.key, { monthly: url(v?.monthly ?? v?.once ?? ''), annual: url(v?.annual ?? v?.once ?? '') }];
}));
---

<BaseLayout
  title="Pricing — Shadow Warden AI"
  description="Transparent pricing for every team size. Free, Individual and Business. 14-day trial, no card required."
  markdown="/pricing.md"
>
  <div class="pt-14" style="background:var(--sw-bg)">

    <!-- Plan configurator: choices on the left, a sticky summary on the right. -->
    <section id="calculator" class="py-14">
      <div class="mx-auto max-w-6xl px-4 lg:px-8">
        <h1 class="text-[clamp(28px,4vw,40px)] font-black tracking-tight mb-2" style="color:var(--ink-1)">Choose your plan</h1>
        <p class="text-[14px] mb-10" style="color:var(--ink-3)">
          14-day trial on paid plans, no card required. Cancel anytime. Prices in USD.
        </p>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
          <div class="space-y-10 min-w-0">

            <!-- 1. Plan -->
            <fieldset>
              <legend class="cfg-h2">Plan</legend>
              <div class="grid gap-3 sm:grid-cols-3">
                {tiers.map((t, i) => (
                  <label class="cfg-option" data-plan-card={t.key}>
                    <input type="radio" name="cfg-plan" value={t.key} class="sr-only"
                           checked={t.key === 'individual'} data-rank={i}
                           data-name={t.name} data-monthly={t.price_monthly} data-annual={t.price_annual} />
                    <span class="cfg-radio" aria-hidden="true"></span>
                    <span class="block text-[14px] font-semibold" style="color:var(--ink-1)">{t.name}</span>
                    <span class="block mt-1 text-[22px] font-black" style="color:var(--ink-1)">
                      {t.price_monthly === 0 ? 'Free' : `$${t.price_monthly}`}
                      {t.price_monthly > 0 && <span class="text-[12px] font-medium" style="color:var(--ink-4)">/mo</span>}
                    </span>
                    <span class="block mt-1 text-[12px]" style="color:var(--ink-4)">
                      {t.features[0]}{t.price_annual > 0 && ` · or $${t.price_annual.toFixed(2)}/yr`}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- 2. What is included -->
            <div>
              <h2 class="cfg-h2">What's included</h2>
              {tiers.map(t => (
                <div class="cfg-table" data-included-for={t.key} hidden={t.key !== 'individual'}>
                  <div class="cfg-row cfg-row-head"><span>Product</span><span>Plan</span></div>
                  {t.features.map(f => (
                    <div class="cfg-row"><span>{f}</span><span class="cfg-ok">Included</span></div>
                  ))}
                  {(t.addons ?? []).map((a: string) => (
                    <div class="cfg-row"><span>{a}</span><span class="cfg-muted">Add-on</span></div>
                  ))}
                  {(t.missing ?? []).map((m: string) => (
                    <div class="cfg-row"><span class="cfg-muted">{m}</span><span class="cfg-muted">Not in this plan</span></div>
                  ))}
                </div>
              ))}
            </div>

            <!-- 3. Add-ons -->
            <fieldset>
              <legend class="cfg-h2">Add-ons</legend>
              <p class="text-[13px] mb-4" style="color:var(--ink-4)">Each add-on is its own subscription: added after the plan, cancelled on its own.</p>
              <div class="space-y-3">
                {addons.map((a: any) => {
                  const varId = VARIANT_IDS[a.key];
                  const url = varId?.monthly ? checkoutUrl(varId.monthly, { embed: true }) : '';
                  const rank = ADDON_MIN_RANK[a.tier] ?? 1;
                  return (
                    <label class="cfg-addon" data-addon={a.key} data-min-rank={rank}>
                      <input type="checkbox" class="cfg-check" value={a.key} disabled={a.planned}
                             data-name={a.name} data-price={a.price} data-url={url} />
                      <span class="min-w-0 flex-1">
                        <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                          <span class="text-[14px] font-semibold" style="color:var(--ink-1)">
                            {a.name}
                            {a.planned && <span class="ml-2 cfg-badge">Planned</span>}
                          </span>
                          <span class="text-[15px] font-semibold" style="color:var(--ink-1)">
                            +${a.price}<span class="text-[12px] font-normal" style="color:var(--ink-4)"> / month</span>
                          </span>
                        </span>
                        <span class="block mt-1 text-[12px] leading-relaxed" style="color:var(--ink-4)">{a.desc}</span>
                        <span class="cfg-addon-note block mt-1 text-[11px]" style="color:var(--acc-amber)" hidden>
                          Needs {a.tier.replace('+', '')} or higher.
                        </span>
                      </span>
                    </label>
                  );
                })}
              </div>
            </fieldset>

            <!-- 4. Billing period -->
            <fieldset>
              <legend class="cfg-h2">Pay monthly or yearly</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="cfg-option">
                  <input type="radio" name="cfg-period" value="monthly" class="sr-only" checked />
                  <span class="cfg-radio" aria-hidden="true"></span>
                  <span class="flex justify-between text-[14px] font-semibold" style="color:var(--ink-1)">
                    Monthly <span id="cfg-monthly-price"></span>
                  </span>
                  <span class="block mt-1 text-[12px]" style="color:var(--ink-4)">Billed each month. Cancel anytime.</span>
                </label>
                <label class="cfg-option">
                  <input type="radio" name="cfg-period" value="annual" class="sr-only" />
                  <span class="cfg-radio" aria-hidden="true"></span>
                  <span class="flex justify-between text-[14px] font-semibold" style="color:var(--ink-1)">
                    <span>Yearly <span class="cfg-badge cfg-badge-save">save 15%</span></span>
                    <span><s id="cfg-annual-list" style="color:var(--ink-4);font-weight:400"></s> <span id="cfg-annual-price"></span></span>
                  </span>
                  <span class="block mt-1 text-[12px]" style="color:var(--ink-4)">The plan is billed once a year. Add-ons stay monthly.</span>
                </label>
              </div>
            </fieldset>
          </div>

          <!-- Summary -->
          <aside class="lg:sticky lg:top-24 space-y-4" aria-label="Plan summary">
            <div class="cfg-card">
              <h2 class="px-5 py-4 text-[16px] font-bold border-b" style="color:var(--ink-1);border-color:rgba(var(--ink-rgb),0.08)">Plan Summary</h2>
              <div class="px-5 py-4 space-y-2 text-[13px]" id="cfg-lines"></div>
              <div class="px-5 py-4 border-t" style="border-color:rgba(var(--ink-rgb),0.08)">
                <div class="flex justify-between text-[16px] font-bold" style="color:var(--ink-1)">
                  <span>Total</span><span id="cfg-total"></span>
                </div>
                <p class="mt-1 text-[12px]" style="color:var(--ink-4)" id="cfg-basis"></p>
              </div>
            </div>
            <div class="cfg-card px-5 py-4">
              <div class="flex justify-between items-baseline text-[16px] font-bold" style="color:var(--ink-1)">
                <span>Due today</span><span>$0 <span class="text-[11px] font-normal" style="color:var(--ink-4)">USD</span></span>
              </div>
              <p class="mt-1 text-[12px]" style="color:var(--ink-4)" id="cfg-due-note"></p>
              <button type="button" id="cfg-cta" class="mt-4 w-full rounded-xl py-3 text-[14px] font-semibold text-white"
                      style="background:linear-gradient(135deg,#6366f1,#8b5cf6)"></button>
              <div id="cfg-addon-ctas" class="mt-3 space-y-2"></div>
              <p class="mt-3 text-center text-[11px]" style="color:var(--ink-5)">Payments are processed by Lemon Squeezy.</p>
            </div>
            <p class="text-center text-[12px]" style="color:var(--ink-4)">
              Questions? <a href="/contact" style="color:var(--acc-violet)">Contact us</a>
            </p>
          </aside>
        </div>
      </div>
    </section>

    <script type="application/json" id="cfg-plan-urls" set:html={JSON.stringify(planUrls)} />

    <!-- ── Profit & ROI Estimator ──────────────────────────────────────── -->
    <section id="roi-estimator" class="pb-24 border-t" style="border-color:rgba(16,185,129,0.15)">
      <div class="mx-auto max-w-5xl px-4 pt-16">

        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-4 text-[11px] font-bold tracking-widest uppercase"
               style="color:#047857;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2)">
            ◈ Marketplace ROI Estimator
          </div>
          <h2 class="text-[22px] font-black mb-2" style="color:var(--ink-1);letter-spacing:-0.02em">
            How much will you earn?
          </h2>
          <p class="text-[13px] max-w-lg mx-auto" style="color:#556072">
            An illustrative model, not measured results — the marketplace is pre-launch.
            The default of 33 trades/community/month is an assumption; set your own forecast.
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden" style="border:1px solid rgba(16,185,129,0.18);background:rgba(16,185,129,0.02)">
          <div class="grid lg:grid-cols-2">

            <!-- LEFT: Inputs -->
            <div class="p-7" style="border-right:1px solid rgba(16,185,129,0.12)">
              <div class="text-[11px] font-semibold uppercase tracking-wider mb-6" style="color:#047857">Your numbers</div>

              <!-- Period toggle -->
              <div class="mb-6">
                <div class="text-[12px] font-semibold mb-2" style="color:var(--ink-3)">Time period</div>
                <div class="inline-flex rounded-lg overflow-hidden" style="border:1px solid rgba(255,255,255,0.1)">
                  <button id="roi-monthly" class="roi-period-btn active px-5 py-2 text-[12px] font-semibold transition-all" data-p="monthly">Monthly</button>
                  <button id="roi-annual"  class="roi-period-btn px-5 py-2 text-[12px] font-semibold transition-all" data-p="annual">
                    Annual
                    <span class="ml-1 px-1.5 py-0.5 rounded text-[9px]" style="color:#047857;background:rgba(16,185,129,0.15)">−15%</span>
                  </button>
                </div>
              </div>

              <!-- Tier selector -->
              <div class="mb-6">
                <div class="text-[12px] font-semibold mb-2" style="color:var(--ink-3)">Plan tier</div>
                <select id="roi-tier" class="w-full px-3 py-2.5 rounded-lg text-[13px] font-medium outline-none transition-all"
                        style="background:var(--sw-bg);border:1px solid rgba(255,255,255,0.1);color:var(--ink-1);-webkit-appearance:none">
                  <option value="starter">Starter — Free (1,000 req/mo)</option>
                  <option value="individual">Individual — $5/mo (5,000 req/mo)</option>
                  <option value="community" selected>Community Business — $39.99/mo (15,000 req/mo)</option>
                </select>
              </div>

              <!-- Trades slider -->
              <div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                  <div class="text-[12px] font-semibold" style="color:var(--ink-3)">Trades per month</div>
                  <div class="text-[14px] font-black tabular-nums" style="color:#047857" id="roi-trades-val">33</div>
                </div>
                <input id="roi-trades" type="range" min="0" max="10000" value="33" step="1" class="roi-slider w-full" />
                <div class="flex justify-between mt-1">
                  <span class="text-[10px]" style="color:#404e66">0</span>
                  <span class="text-[10px]" style="color:#404e66">10,000</span>
                </div>
              </div>

              <!-- AOV input -->
              <div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                  <div class="text-[12px] font-semibold" style="color:var(--ink-3)">Avg. order value (USD)</div>
                  <div class="text-[14px] font-black tabular-nums" style="color:#047857" id="roi-aov-display">$500</div>
                </div>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[13px]" style="color:#556072">$</span>
                  <input id="roi-aov" type="number" min="0" max="1000000" value="500" step="1"
                         class="w-full pl-7 pr-3 py-2.5 rounded-lg text-[13px] font-medium outline-none"
                         style="background:var(--sw-bg);border:1px solid rgba(255,255,255,0.1);color:var(--ink-1)" />
                </div>
              </div>

              <!-- API calls slider -->
              <div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                  <div class="text-[12px] font-semibold" style="color:var(--ink-3)">Monthly search API calls (x402)</div>
                  <div class="text-[14px] font-black tabular-nums" style="color:#047857" id="roi-api-val">10,000</div>
                </div>
                <input id="roi-api" type="range" min="0" max="1000000" value="10000" step="1000" class="roi-slider w-full" />
                <div class="flex justify-between mt-1">
                  <span class="text-[10px]" style="color:#404e66">0</span>
                  <span class="text-[10px]" style="color:#404e66">1M</span>
                </div>
              </div>

              <!-- Sponsored listing toggle -->
              <div class="flex items-center justify-between py-3 px-4 rounded-lg" style="background:rgba(251,191,36,0.04);border:1px solid rgba(251,191,36,0.12)">
                <div>
                  <div class="text-[12px] font-semibold" style="color:var(--acc-amber)">Sponsored listing boost (+0.15 similarity)</div>
                  <div class="text-[11px] mt-0.5" style="color:#556072">pgvector priority placement — $29/mo add-on</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input id="roi-sponsored" type="checkbox" class="sr-only" />
                  <div id="roi-sponsored-track" class="w-9 h-5 rounded-full transition-all" style="background:rgba(255,255,255,0.1)">
                    <div id="roi-sponsored-thumb" class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-[#fff] transition-all shadow-sm"></div>
                  </div>
                </label>
              </div>
            </div>

            <!-- RIGHT: Results -->
            <div class="p-7 flex flex-col">
              <div class="text-[11px] font-semibold uppercase tracking-wider mb-6" style="color:#047857">Your projection</div>

              <!-- Net profit counter -->
              <div class="text-center mb-8 py-6 rounded-xl" style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15)">
                <div class="text-[11px] uppercase tracking-widest mb-2" style="color:#556072">Projected net profit</div>
                <div id="roi-net" class="text-[48px] font-black leading-none tabular-nums" style="color:#047857;font-variant-numeric:tabular-nums;letter-spacing:-0.03em">$0</div>
                <div id="roi-period-label" class="text-[11px] mt-2" style="color:#556072">per month</div>
                <div id="roi-margin" class="text-[12px] font-semibold mt-1" style="color:#047857"></div>
              </div>

              <!-- Breakdown table -->
              <div class="space-y-2 mb-6 flex-1">
                {[
                  { id: 'roi-r-gmv',     label: 'Gross Revenue (GMV)',         icon: '+', color: '#1d4ed8' },
                  { id: 'roi-r-take',    label: 'Platform take rate',           icon: '−', color: '#b91c1c' },
                  { id: 'roi-r-sub',     label: 'SaaS subscription',            icon: '−', color: '#b91c1c' },
                  { id: 'roi-r-x402',    label: 'x402 compute costs',           icon: '−', color: '#b91c1c' },
                  { id: 'roi-r-sponsor', label: 'Sponsored listing boost',       icon: '−', color: '#b45309' },
                ].map(r => (
                  <div class="flex items-center justify-between py-2 px-3 rounded-lg" style="background:rgba(255,255,255,0.02)">
                    <div class="flex items-center gap-2">
                      <span class="text-[11px] font-mono w-4 text-center" style={`color:${r.color}`}>{r.icon}</span>
                      <span class="text-[12px]" style="color:var(--ink-3)">{r.label}</span>
                    </div>
                    <span class="text-[13px] font-bold tabular-nums" id={r.id} style={`color:${r.color}`}>$0.00</span>
                  </div>
                ))}

                <div class="flex items-center justify-between py-2.5 px-3 rounded-lg mt-1" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2)">
                  <span class="text-[13px] font-bold" style="color:#047857">Net Profit</span>
                  <span class="text-[16px] font-black tabular-nums" id="roi-r-net" style="color:#047857">$0.00</span>
                </div>
              </div>

              <!-- Upsell tip -->
              <div id="roi-upsell" class="hidden rounded-lg p-4" style="background:rgba(128,180,253,0.08);border:1px solid rgba(128,180,253,0.22)">
                <div class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round" class="flex-shrink-0 mt-0.5">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                  </svg>
                  <div>
                    <div class="text-[12px] font-semibold mb-1" style="color:#1d4ed8">Smart upgrade suggestion</div>
                    <div class="text-[11px] leading-relaxed" id="roi-upsell-text" style="color:var(--ink-3)"></div>
                    <a href="#roi-estimator" onclick="document.getElementById('roi-tier').value=this.dataset.tier;window._roiCalc();return false;"
                       id="roi-upsell-cta" data-tier="community"
                       class="inline-block mt-2 text-[11px] font-semibold px-3 py-1 rounded"
                       style="color:#1d4ed8;background:rgba(128,180,253,0.12);border:1px solid rgba(128,180,253,0.25)">
                       Apply upgrade →
                    </a>
                  </div>
                </div>
              </div>

              <!-- ROI vs breach cost -->
              <div id="roi-roi-box" class="mt-4 text-center py-3 rounded-lg" style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.06)">
                <div class="text-[11px]" style="color:#475569">Annual ROI vs. $4.88M IBM breach cost</div>
                <div id="roi-roi-val" class="text-[20px] font-black" style="color:var(--acc-amber)">—</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ strip -->
    <section class="pb-20 border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-3xl px-4 pt-16">
        <h2 class="text-[20px] font-bold mb-8 text-center" style="color:var(--ink-1)">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {[
            { q: 'Do you offer a free trial?', a: '14 days on Individual and Community Business — no credit card required.' },
            { q: 'Can I upgrade or downgrade?', a: 'Yes. Upgrades are immediate; downgrades take effect at the next billing date. Managed through the Lemon Squeezy Customer Portal.' },
            { q: 'What payment methods do you accept?', a: 'All major credit/debit cards, and PayPal. Processed securely by Lemon Squeezy.' },
            { q: 'Is my data safe during checkout?', a: 'All payments are handled by Lemon Squeezy (PCI-DSS Level 1). Shadow Warden AI never sees your card details.' },
