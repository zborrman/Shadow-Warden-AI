<script>
(function () {
  // ── ROI Estimator ───────────────────────────────────────────────────────────
  (function roiEstimator() {
    // Tier config — all costs in CENTS to avoid float drift
    const TIERS: Record<string, { sub: number; takeRate: number; name: string; upsell: string | null; upsellTo: string | null }> = {
      starter:   { sub: 0,    takeRate: 0,     name: 'Starter',            upsell: null, upsellTo: null },
      individual:{ sub: 500,  takeRate: 0,     name: 'Individual',         upsell: 'At this GMV, upgrading to Community Business unlocks the SOVA AI agent, 1.5% take rate vs high per-action fees, and 180-day log retention — net profit improves above $1,000/mo GMV.', upsellTo: 'community' },
      community: { sub: 3999, takeRate: 0.015, name: 'Community Business', upsell: null, upsellTo: null },
    };
    const SPONSOR_COST_CENTS = 2900; // $29/mo

    // Grab DOM
    const el = (id: string) => document.getElementById(id) as HTMLElement | null;

    function fmtDollars(cents: number): string {
      const abs = Math.abs(cents) / 100;
      const s = abs.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return (cents < 0 ? '-' : '') + '$' + s;
    }
    function fmtShort(n: number): string {
      if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
      if (n >= 1_000)     return (n / 1_000).toFixed(n >= 10_000 ? 0 : 1) + 'k';
      return n.toLocaleString();
    }

    function calc() {
      const tierKey  = (el('roi-tier') as HTMLSelectElement)?.value ?? 'community';
      const trades   = parseInt((el('roi-trades') as HTMLInputElement)?.value ?? '33', 10);
      const aov      = parseFloat((el('roi-aov') as HTMLInputElement)?.value ?? '500');
      const apiCalls = parseInt((el('roi-api') as HTMLInputElement)?.value ?? '10000', 10);
      const isAnnual = (el('roi-annual') as HTMLElement)?.classList.contains('active') ?? false;
      const sponsored = (el('roi-sponsored') as HTMLInputElement)?.checked ?? false;
      const t = TIERS[tierKey] ?? TIERS['community'];

      // All math in cents
      const periodFactor   = isAnnual ? 12 : 1;
      const subCents       = Math.round(t.sub * periodFactor * (isAnnual ? 0.85 : 1));
      const gmvCents       = Math.round(trades * (isAnnual ? 12 : 1) * Math.max(0, aov) * 100);
      const takeCents      = Math.round(gmvCents * t.takeRate);
      const apiCostCents   = Math.round(apiCalls * (isAnnual ? 12 : 1) * 0.0001); // $0.000001 per call = 0.0001 cents
      const sponsorCents   = sponsored ? Math.round(SPONSOR_COST_CENTS * (isAnnual ? 12 : 1) * (isAnnual ? 0.85 : 1)) : 0;
      const netCents       = gmvCents - takeCents - subCents - apiCostCents - sponsorCents;
      const marginPct      = gmvCents > 0 ? Math.round((netCents / gmvCents) * 100) : 0;

      // Animate net profit counter
      const netEl = el('roi-net');
      if (netEl) {
        netEl.textContent = fmtDollars(netCents);
        netEl.style.color = netCents < 0 ? '#b91c1c' : '#047857';
      }

      // Period label
      const periodLabelEl = el('roi-period-label');
      if (periodLabelEl) periodLabelEl.textContent = isAnnual ? 'per year' : 'per month';

      // Margin
      const marginEl = el('roi-margin');
      if (marginEl) {
        marginEl.textContent = gmvCents > 0 ? `${marginPct}% margin` : '';
        marginEl.style.color = marginPct >= 80 ? '#047857' : marginPct >= 50 ? '#b45309' : '#b91c1c';
      }

      // Breakdown
      const set = (id: string, v: number) => { const e = el(id); if (e) e.textContent = fmtDollars(v); };
      set('roi-r-gmv',    gmvCents);
      set('roi-r-take',   takeCents);
      set('roi-r-sub',    subCents);
      set('roi-r-x402',   apiCostCents);
      set('roi-r-sponsor', sponsorCents);
      set('roi-r-net',    netCents);

      const sponsorRow = el('roi-r-sponsor')?.closest<HTMLElement>('.flex');
      if (sponsorRow) sponsorRow.style.opacity = sponsored ? '1' : '0.35';

      // ROI vs breach cost ($4.88M = 488000000 cents)
      const annualNet = isAnnual ? netCents : netCents * 12;
      const roiEl = el('roi-roi-val');
      if (roiEl && annualNet > 0) {
        const roi = (488_000_000 / Math.max(1, Math.abs(subCents * (isAnnual ? 1 : 12)))).toFixed(0);
        roiEl.textContent = `${Number(roi).toLocaleString()}× cost avoided`;
      } else if (roiEl) {
        roiEl.textContent = '—';
      }

      // Upsell logic
      const upsellEl = el('roi-upsell');
      const upsellText = el('roi-upsell-text');
      const upsellCta  = el('roi-upsell-cta') as HTMLAnchorElement | null;
      const showUpsell = t.upsell && gmvCents >= 100_000; // $1,000+ GMV
      if (upsellEl) upsellEl.classList.toggle('hidden', !showUpsell);
      if (showUpsell && upsellText) upsellText.textContent = t.upsell!;
      if (showUpsell && upsellCta && t.upsellTo) upsellCta.dataset.tier = t.upsellTo;

      // Update slider track fill
      const updateFill = (sliderId: string, max: number) => {
        const s = el(sliderId) as HTMLInputElement | null;
        if (!s) return;
        const pct = (+s.value / max) * 100;
        s.style.background = `linear-gradient(to right, #047857 ${pct}%, rgba(255,255,255,0.1) ${pct}%)`;
      };
      updateFill('roi-trades', 10000);
      updateFill('roi-api', 1000000);
    }

    // Expose for inline onclick
    (window as any)._roiCalc = calc;

    // Period toggle
    const monthBtn = el('roi-monthly');
    const yearBtn  = el('roi-annual');
    monthBtn?.addEventListener('click', () => {
      monthBtn.classList.add('active'); yearBtn?.classList.remove('active'); calc();
    });
    yearBtn?.addEventListener('click', () => {
      yearBtn.classList.add('active'); monthBtn?.classList.remove('active'); calc();
    });

    // Trades slider
    const tradesSlider = el('roi-trades') as HTMLInputElement | null;
    tradesSlider?.addEventListener('input', () => {
      const v = parseInt(tradesSlider.value, 10);
      const d = el('roi-trades-val'); if (d) d.textContent = fmtShort(v);
      calc();
    });

    // AOV input
    const aovInput = el('roi-aov') as HTMLInputElement | null;
    aovInput?.addEventListener('input', () => {
      const d = el('roi-aov-display');
      if (d) d.textContent = '$' + (parseFloat(aovInput.value) || 0).toLocaleString();
      calc();
    });

    // API calls slider
    const apiSlider = el('roi-api') as HTMLInputElement | null;
    apiSlider?.addEventListener('input', () => {
      const v = parseInt(apiSlider.value, 10);
      const d = el('roi-api-val'); if (d) d.textContent = fmtShort(v);
      calc();
    });

    // Tier select
    el('roi-tier')?.addEventListener('change', calc);

    // Sponsored toggle
    const sponsoredCb = el('roi-sponsored') as HTMLInputElement | null;
    const track = el('roi-sponsored-track');
    const thumb = el('roi-sponsored-thumb');
    sponsoredCb?.addEventListener('change', () => {
      const on = sponsoredCb.checked;
      if (track) track.style.background = on ? '#047857' : 'rgba(255,255,255,0.1)';
      if (thumb) thumb.style.transform = on ? 'translateX(16px)' : 'translateX(0)';
      calc();
    });

    // Initial render
    calc();
  })();

})();
</script>

<script>
// Plan configurator: the summary is recomputed from the checked inputs, which
// carry the prices rendered from the same `tiers` / `addons` data as the page.
(function () {
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null
  const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 })
  const planInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cfg-plan"]'))
  const periodInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cfg-period"]'))
  const addonInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.cfg-check'))
  const PLAN_URLS: Record<string, { monthly: string; annual: string }> =
    JSON.parse(document.getElementById('cfg-plan-urls')?.textContent || '{}')

  const saved = localStorage.getItem('sw-billing')
  if (saved === 'annual') periodInputs.forEach(i => { i.checked = i.value === 'annual' })

  function open(url: string) {
    if (!url) return
    if (url.startsWith('mailto:') || url.startsWith('http') && !url.includes('lemonsqueezy')) { window.location.href = url; return }
    const ls = (window as unknown as { lsCheckout?: (u: string) => void }).lsCheckout
    if (typeof ls === 'function') ls(url)
    else window.open(url, '_blank', 'noopener')
  }

  function render() {
    const plan = planInputs.find(i => i.checked) ?? planInputs[0]
    const annual = periodInputs.find(i => i.checked)?.value === 'annual'
    localStorage.setItem('sw-billing', annual ? 'annual' : 'monthly')
    const rank = Number(plan.dataset.rank)
    const monthly = Number(plan.dataset.monthly)
    const yearly = Number(plan.dataset.annual)
    const free = monthly === 0

    document.querySelectorAll<HTMLElement>('[data-plan-card]').forEach(c =>
      c.classList.toggle('is-checked', c.dataset.planCard === plan.value))
    document.querySelectorAll<HTMLElement>('[data-included-for]').forEach(t => {
      t.hidden = t.dataset.includedFor !== plan.value
    })
    periodInputs.forEach(i => i.closest('.cfg-option')?.classList.toggle('is-checked', i.checked))
    periodInputs.forEach(i => { i.disabled = free })

    // Add-ons need a high enough plan; one that does not fit is unticked.
    addonInputs.forEach(i => {
      const row = i.closest<HTMLElement>('.cfg-addon')!
      const fits = rank >= Number(row.dataset.minRank)
      if (!fits) i.checked = false
      i.disabled = !fits || row.querySelector('.cfg-badge') !== null
      row.classList.toggle('is-disabled', i.disabled)
      row.classList.toggle('is-checked', i.checked)
      const note = row.querySelector<HTMLElement>('.cfg-addon-note')
      if (note) note.hidden = fits
    })
    const picked = addonInputs.filter(i => i.checked)

    $('cfg-monthly-price')!.textContent = free ? 'Free' : `${money(monthly)}/mo`
    $('cfg-annual-list')!.textContent = free ? '' : money(monthly * 12)
    $('cfg-annual-price')!.textContent = free ? '' : `${money(yearly)}/yr`

    const lines: [string, string][] = [[`${plan.dataset.name} plan`,
      free ? 'Free' : annual ? `${money(yearly)}/yr` : `${money(monthly)}/mo`]]
    picked.forEach(i => lines.push([i.dataset.name!, `${money(Number(i.dataset.price))}/mo`]))
    $('cfg-lines')!.replaceChildren(...lines.map(([name, price]) => {
      const row = document.createElement('div')
      row.className = 'flex justify-between gap-3'
      row.innerHTML = '<span style="color:var(--ink-2)"></span><span style="color:var(--ink-1);font-weight:600"></span>'
      row.children[0].textContent = name
      row.children[1].textContent = price
      return row
    }))

    const addonsMonthly = picked.reduce((s, i) => s + Number(i.dataset.price), 0)
    const perMonth = (annual ? yearly / 12 : monthly) + addonsMonthly
    $('cfg-total')!.textContent = free && !addonsMonthly ? 'Free' : `${money(Math.round(perMonth * 100) / 100)}/mo`
    $('cfg-basis')!.textContent = free ? 'No card, no charge.'
      : annual ? `Plan billed ${money(yearly)} once a year${addonsMonthly ? '; add-ons monthly' : ''}.`
      : 'Billed monthly.'
    $('cfg-due-note')!.textContent = free ? 'The Starter plan is free.' : 'Paid plans start with a 14-day trial.'

    const cta = $('cfg-cta') as HTMLButtonElement
    cta.textContent = free ? 'Create a free account' : `Start ${plan.dataset.name} trial`
    cta.onclick = () => free
      ? window.location.assign('https://portal.shadow-warden-ai.com/register/')
      : open(annual ? PLAN_URLS[plan.value]?.annual : PLAN_URLS[plan.value]?.monthly)

    $('cfg-addon-ctas')!.replaceChildren(...picked.map(i => {
      const b = document.createElement('button')
      b.type = 'button'
      b.className = 'w-full rounded-xl py-2 text-[12px] font-semibold'
      b.style.cssText = 'color:var(--acc-violet);border:1px solid rgba(129,140,248,0.35);background:rgba(129,140,248,0.06)'
      b.textContent = `Add ${i.dataset.name}`
      b.onclick = () => open(i.dataset.url || '')
      return b
    }))
  }

  ;[...planInputs, ...periodInputs, ...addonInputs].forEach(i => i.addEventListener('change', render))
  render()
})()
</script>
