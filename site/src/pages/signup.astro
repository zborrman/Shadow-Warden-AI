---
import AuthPulse from '../components/auth/AuthPulse.astro';
// Site accounts were retired on 2026-11-26: the old form checked passwords
// against the portal's account table with no second factor. Accounts are
// created in the portal only. This page stays for old links and never asks
// for a password.
const PORTAL = 'https://portal.shadow-warden-ai.com';
---
<AuthPulse title="Create Account — Shadow Warden AI" step="Create account" heading="Create your account"
           lead="Your account lives in the Shadow Warden portal: a strong password, two-step verification and password reset by email.">
  <a id="continue-btn" class="ap-primary" href={`${PORTAL}/register`}>Continue to the portal</a>
  <ul class="ap-points">
    <li>Strong password, checked on the server</li>
    <li>Two-step verification with an authenticator app</li>
    <li>Password reset by a link sent to your email</li>
  </ul>
  <p class="ap-row">Already have an account? <a href={`${PORTAL}/login`} class="ap-link">Sign in</a></p>
</AuthPulse>
