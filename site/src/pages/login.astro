---
import AuthPulse from '../components/auth/AuthPulse.astro';
// Site accounts were retired on 2026-11-26 (see signup.astro). Sign-in happens
// in the portal, with two-step verification. This page stays for old links.
const PORTAL = 'https://portal.shadow-warden-ai.com';
---
<AuthPulse title="Sign In — Shadow Warden AI" step="Sign in" heading="Sign in to your account"
           lead="Sign-in happens in the Shadow Warden portal, with two-step verification.">
  <a id="continue-btn" class="ap-primary" href={`${PORTAL}/login`}>Continue to sign in</a>
  <p class="ap-row">Forgot your password? <a href={`${PORTAL}/forgot-password`} class="ap-link">Reset it</a></p>
  <p class="ap-row">Don&apos;t have an account? <a href={`${PORTAL}/register`} class="ap-link">Create one</a></p>
</AuthPulse>
