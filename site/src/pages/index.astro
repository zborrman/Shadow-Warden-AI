---
// Homepage (owner decision 2026-11-24): the product is seller protection.
// Every "Available now" item is a shipped feature with a row in
// docs/capability-matrix.md; "In development" items are labelled as such and
// promise nothing. SP-06: we estimate risk from the seller's own data; Amazon
// decides. Never write that anything prevents a suspension.
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCT } from '../data/product';

const PORTAL = 'https://portal.shadow-warden-ai.com';

// Machine-readable identity. The offer range is pinned to warden.billing.pricing
// by warden/tests/test_pricing_coherence.py; /price lists every plan in it.
const softwareApplication = {
  '@type': 'SoftwareApplication',
  '@id': 'https://shadow-warden-ai.com/#software',
  name: 'Shadow Warden AI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Marketplace seller account protection',
  operatingSystem: 'Web',
  url: 'https://shadow-warden-ai.com',
  description: 'A workspace for Amazon sellers to catch listing, labelling, barcode and account-health risks early, from their own data. Independent of Amazon; never connects to Seller Central.',
  featureList: [
    'Listing check for claims that need proof (pesticide, medical, green, absolute)',
    'Account-health calculator for the rates Amazon measures',
    'GTIN check digits verified as you type',
    'Print-ready FNSKU and barcode labels',
    'EU product-safety (GPSR) details on products',
  ],
  softwareVersion: PRODUCT.version,
  publisher: { '@id': 'https://shadow-warden-ai.com/#organization' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '0',
    highPrice: '39.99',
    offerCount: 3,
    url: 'https://shadow-warden-ai.com/price',
  },
};

const risks = [
  {
    k: 'Listings',
    title: 'One word can take a listing down',
    body: 'Words such as “antibacterial”, “cures” or “eco-friendly” are claims that need proof. A listing that makes one without it can be removed, and repeated removals weigh on the account.',
  },
  {
    k: 'Metrics',
    title: 'Account health is a few percentages',
    body: 'Order defects, late shipments, cancellations and tracking are measured as rates. Sellers often notice them when they are already past a limit, not while there is still time to act.',
  },
  {
    k: 'FBA',
    title: 'Since 1 January 2026, labels are yours',
    body: 'Amazon ended US FBA prep and item labelling. A wrong or unreadable label is now the seller’s problem at the fulfilment centre.',
  },
];

const now = [
  {
    tag: 'Listing check',
    title: 'Flags claims that need proof',
    points: [
      'Pesticide, medical, green and absolute claims in your own titles and descriptions',
      'Every finding cites its public basis: EPA/FIFRA, FDA, FTC Green Guides, EU 2024/825',
      'Run it on one product or on your catalog export',
      'Advice only: it cannot know what a marketplace will remove',
    ],
  },
  {
    tag: 'Account health',
    title: 'A calculator for the rates that matter',
    points: [
      'Order defect, late shipment, cancellation and valid-tracking rates',
      'Type your own numbers and see where you stand against each limit',
      'Runs in your browser; nothing is read from Amazon',
    ],
  },
  {
    tag: 'Barcodes & labels',
    title: 'Codes that scan, labels that print',
    points: [
      'GS1 check digit verified before a GTIN is saved',
      'FNSKU and barcode labels: A4, US Letter, 50 × 25 mm rolls or ZPL',
      'Bars drawn as vectors, so the printer cannot blur them',
    ],
  },
  {
    tag: 'EU product safety',
    title: 'The GPSR details EU buyers must see',
    points: [
      'Manufacturer, EU responsible person and warnings on each product',
      'Shown on your own storefront',
      'You enter them; we do not verify them',
    ],
  },
];

const next = [
  ['Account-health history', 'Upload the reports you already download from Seller Central and see each rate over time, with a warning before it reaches a limit.'],
  ['Evidence vault', 'Supplier invoices, brand authorisations and certificates in one place, with expiry reminders, ready when Amazon asks for documents.'],
  ['Appeal workspace', 'A structured draft of a plan of action, built from your own documents, for you to review and send yourself.'],
];

const rules = [
  ['We never log in to Seller Central', 'No scraping, no browser automation. Tools that act inside your account break Amazon’s rules and can tie your account to others.'],
  ['We never ask for your Amazon password', 'You export reports and upload them. Nothing else.'],
  ['We send nothing on your behalf', 'Messages and appeals are drafts. You read them and you send them.'],
  ['We estimate risk; Amazon decides', 'No tool can guarantee an account stays open. We help you see problems sooner.'],
];

const faq = [
  ['Is this an Amazon product?', 'No. Shadow Warden AI is independent and not affiliated with or endorsed by Amazon.'],
  ['Can you guarantee my account will not be suspended?', 'No, and nobody honestly can: Amazon makes that decision. We help you find risks in your listings, labels and metrics earlier, while there is still time to fix them.'],
  ['Where is my data?', 'On our servers in Germany (EU). Labels are made in your browser.'],
  ['What does it cost?', 'You can start free, with no card.'],
];
---

<BaseLayout
  markdown="/index.md"
  jsonLd={softwareApplication}
  title="Shadow Warden AI — see Amazon account risk before Amazon does"
  description="Check listings for claims that need proof, track the rates behind Amazon account health, and print labels that scan. From your own data; never logs in to Seller Central."
>
  <div class="pt-14" style="background:#03050f">

    <section class="sl-hero">
      <div class="mx-auto max-w-6xl px-4 lg:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="sl-eyebrow">For Amazon sellers</p>
          <h1 class="sl-h1">See the risk<br/>before Amazon does.</h1>
          <p class="sl-sub">
            Check listings for claims that need proof, keep an eye on the rates behind account health, and print labels
            that scan, from your own data and without ever logging in to Seller Central.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={`${PORTAL}/register/`} class="sl-btn-p">Start free</a>
            <a href="/sellers#catalog-check" class="sl-btn-g">Check your catalog free →</a>
          </div>
          <p class="mt-4 text-[12px]" style="color:#94a3b8">No card. Data stored in Germany (EU). Independent of Amazon.</p>
        </div>

        <div class="sl-card" role="img" aria-label="Example output of the listing check">
          <p class="text-[12px] font-semibold mb-3" style="color:#94a3b8">Listing check · example</p>
          <p class="text-[14px] leading-relaxed mb-4" style="color:#e2e8f0">
            Bamboo cutting board, <span class="hp-flag">antibacterial</span>, <span class="hp-flag">100% eco-friendly</span>, dishwasher safe
          </p>
          <ul class="space-y-2 text-[13px]" style="color:#cbd5e1">
            <li><span style="color:#fb923c">●</span> “antibacterial”: a pesticidal claim that needs registration or proof (EPA/FIFRA)</li>
            <li><span style="color:#fb923c">●</span> “100% eco-friendly”: a broad environmental claim (FTC Green Guides, EU 2024/825)</li>
          </ul>
          <p class="text-[11px] mt-4" style="color:#94a3b8">An illustration of the check’s output, not a real seller’s listing.</p>
        </div>
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-6xl px-4 lg:px-8 py-16">
        <h2 class="sl-h2">Where accounts get into trouble</h2>
        <div class="grid gap-4 md:grid-cols-3 mt-8">
          {risks.map(f => (
            <div class="sl-card">
              <div class="sl-fact-k">{f.k}</div>
              <h3 class="text-[16px] font-bold mb-2" style="color:#f1f5f9">{f.title}</h3>
              <p class="text-[13px] leading-relaxed" style="color:#94a3b8">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-6xl px-4 lg:px-8 py-16">
        <h2 class="sl-h2">Available now</h2>
        <div class="grid gap-4 md:grid-cols-2 mt-8">
          {now.map(f => (
            <div class="sl-card">
              <span class="sl-tag">{f.tag}</span>
              <h3 class="text-[18px] font-bold mt-3 mb-3" style="color:#f1f5f9">{f.title}</h3>
              <ul class="space-y-2">
                {f.points.map(p => (
                  <li class="flex gap-2 text-[13px]" style="color:#cbd5e1">
                    <span style="color:#818cf8">✓</span><span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="text-[13px] mt-6" style="color:#94a3b8">
          The same workspace also runs your own storefront in five languages, with a customer list that stays yours.
          <a href="/sellers" style="color:#a5b4fc">More for sellers →</a>
        </p>
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-6xl px-4 lg:px-8 py-16">
        <h2 class="sl-h2">In development</h2>
        <p class="text-[14px] mt-2 max-w-2xl" style="color:#94a3b8">Not available yet. Listed so you know where the product is going.</p>
        <div class="grid gap-4 md:grid-cols-3 mt-8">
          {next.map(([t, b]) => (
            <div class="sl-card">
              <span class="sl-tag hp-planned">Planned</span>
              <h3 class="text-[16px] font-bold mt-3 mb-2" style="color:#f1f5f9">{t}</h3>
              <p class="text-[13px] leading-relaxed" style="color:#94a3b8">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-6xl px-4 lg:px-8 py-16">
        <h2 class="sl-h2">Built so it can never be the problem</h2>
        <div class="grid gap-4 md:grid-cols-2 mt-8">
          {rules.map(([t, b]) => (
            <div class="sl-card">
              <h3 class="text-[16px] font-bold mb-2" style="color:#34d399">{t}</h3>
              <p class="text-[13px] leading-relaxed" style="color:#cbd5e1">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-3xl px-4 lg:px-8 py-16">
        <h2 class="sl-h2 mb-6">Questions</h2>
        {faq.map(([q, a]) => (
          <details class="sl-faq">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="border-t" style="border-color:rgba(255,255,255,0.06)">
      <div class="mx-auto max-w-4xl px-4 lg:px-8 py-16">
        <div class="sl-offer">
          <h2 class="text-[clamp(24px,3.5vw,36px)] font-black mb-4" style="color:#f1f5f9">Check your next listing before you publish it</h2>
          <p class="text-[14px] mb-6" style="color:#94a3b8">Free to start. No card.</p>
          <a href={`${PORTAL}/register/`} class="sl-btn-p">Start free</a>
          <p class="text-[12px] mt-6" style="color:#94a3b8">
            Developers: the screening engine behind the workspace has an API. <a href="/doc" style="color:#a5b4fc">Documentation</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sl-hero { background: radial-gradient(ellipse 900px 500px at 20% 0%, rgba(129,140,248,0.10), transparent 70%); }
  .sl-eyebrow { font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#818cf8; margin-bottom:16px; }
  .sl-h1 { font-size:clamp(36px,5.5vw,64px); line-height:1.05; font-weight:900; letter-spacing:-.02em; color:#f8fafc; margin-bottom:20px; }
  .sl-sub { font-size:17px; line-height:1.6; color:#94a3b8; max-width:560px; margin-bottom:28px; }
  .sl-h2 { font-size:clamp(22px,3vw,30px); font-weight:800; color:#f1f5f9; letter-spacing:-.01em; }
  .sl-btn-p { display:inline-flex; align-items:center; padding:12px 26px; border-radius:10px; font-size:14px; font-weight:700;
    color:#fff; background:linear-gradient(135deg,#6366f1,#8b5cf6); text-decoration:none; }
  .sl-btn-p:hover { filter:brightness(1.1); }
  .sl-btn-g { display:inline-flex; align-items:center; padding:12px 22px; border-radius:10px; font-size:14px; font-weight:600;
    color:#c7d2fe; border:1px solid rgba(129,140,248,0.35); text-decoration:none; }
  .sl-btn-g:hover { border-color:rgba(129,140,248,0.7); }
  .sl-card { border:1px solid rgba(255,255,255,0.08); border-radius:14px; background:rgba(255,255,255,0.025); padding:22px; }
  .sl-fact-k { font-size:13px; font-weight:800; color:#fb923c; margin-bottom:8px; }
  .sl-tag { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:#a5b4fc; background:rgba(129,140,248,0.12); padding:3px 9px; border-radius:6px; }
  .sl-step { width:28px; height:28px; border-radius:999px; display:grid; place-content:center; font-weight:800; font-size:13px;
    color:#03050f; background:#a5b4fc; margin-bottom:12px; }
  .sl-offer { border:1px solid rgba(129,140,248,0.35); border-radius:18px; padding:36px;
    background:linear-gradient(160deg, rgba(99,102,241,0.12), rgba(139,92,246,0.05)); text-align:center; }
  .sl-faq { padding:16px 0; border-top:1px solid rgba(255,255,255,0.08); }
  .sl-faq summary { cursor:pointer; font-size:15px; font-weight:600; color:#f1f5f9; }
  .sl-faq p { margin-top:10px; font-size:14px; line-height:1.6; color:#94a3b8; }
  /* Label preview: white stickers, as printed (counter-inverted in the light theme by the media rule). */
  .sl-preview { position:relative; display:grid; gap:18px; justify-items:center; }
  .sl-label { width:300px; background:#fff; border-radius:6px; padding:12px 14px 10px; box-shadow:0 20px 50px rgba(0,0,0,0.45); transform:rotate(-2deg); }
  .sl-label-2 { transform:rotate(1.5deg); }
  .sl-label-title { display:flex; justify-content:space-between; font:700 13px/1.2 Arial, sans-serif; color:#111; margin-bottom:8px; }
  .sl-bars { height:54px; background:repeating-linear-gradient(90deg,#111 0 2px,#fff 2px 4px,#111 4px 5px,#fff 5px 8px,#111 8px 11px,#fff 11px 12px,#111 12px 13px,#fff 13px 16px); }
  .sl-bars-2 { background:repeating-linear-gradient(90deg,#111 0 1px,#fff 1px 3px,#111 3px 6px,#fff 6px 7px,#111 7px 8px,#fff 8px 11px,#111 11px 13px,#fff 13px 14px); }
  .sl-label-code { font:12px/1.2 'Courier New', monospace; color:#111; text-align:center; margin-top:4px; letter-spacing:.08em; }
  .sl-label-cond { font:11px Arial, sans-serif; color:#111; margin-top:2px; }
  .sl-preview-cap { font-size:11px; color:#64748b; }
  .hp-flag { background:rgba(251,146,60,.22); color:#fed7aa; padding:0 4px; border-radius:3px; }
  .hp-planned { color:#fbbf24 !important; background:rgba(251,191,36,0.10) !important; }
</style>
